---
/**
 * Randevu ve bilgi talebi formu.
 * Sunucu ya da e-posta servisi gerekmez: gönderince alanlar hazır bir WhatsApp mesajına çevrilir ve
 * klinik numarasıyla sohbet açılır; ziyaretçi WhatsApp'ta "Gönder"e basınca mesaj klinik telefonuna düşer.
 * Numara src/config/site.ts → formWhatsapp (test için .env'deki PUBLIC_FORM_WHATSAPP).
 */
import Icon from '@/components/ui/Icon.astro';
import { treatments } from '@/data/treatments';
import { formWhatsapp } from '@/config/site';
import { getDictionary, localizePath, localeMeta, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const f = t.contact.form;
// Klinik ekibi Türkçe okur: tedavi adının Türkçesi de mesaja eklenir
const trDict = getDictionary('tr');

/** Mesaj şablonu: etiketler ziyaretçinin dilinde, kaynak satırı klinik için Türkçe */
const labels = JSON.stringify({
  intro: t.common.whatsappMessage,
  source: `Web sitesi formu · ${localeMeta[lang].nativeName}`,
  name: f.name,
  phone: f.phone,
  email: f.email,
  country: f.country,
  treatment: f.treatment,
  message: f.message,
});
const waBase = `https://wa.me/${formWhatsapp}`;
---

<form class="cform" data-contact-form data-wa={waBase} data-labels={labels} novalidate>
  <header class="cform__head">
    <h2>{f.title}</h2>
    <p class="muted">{f.lead}</p>
  </header>

  <div class="cform__grid">
    <div class="field">
      <label for="cf-name">{f.name} *</label>
      <input id="cf-name" name="name" class="input" type="text" autocomplete="name" maxlength="100" required />
    </div>
    <div class="field">
      <label for="cf-email">{f.email}</label>
      <input id="cf-email" name="email" class="input" type="email" autocomplete="email" maxlength="120" />
    </div>
    <div class="field">
      <label for="cf-phone">{f.phone} *</label>
      <input id="cf-phone" name="phone" class="input" type="tel" autocomplete="tel" placeholder={f.phoneHint} maxlength="30" required />
    </div>
    <div class="field">
      <label for="cf-country">{f.country}</label>
      <input id="cf-country" name="country" class="input" type="text" autocomplete="country-name" maxlength="60" />
    </div>
    <div class="field cform__full">
      <label for="cf-treatment">{f.treatment}</label>
      <select id="cf-treatment" name="treatment" class="input">
        <option value="">{f.treatmentPlaceholder}</option>
        {
          treatments.map((tr) => (
            <option value={t.treatments.items[tr.slug].name} data-tr={trDict.treatments.items[tr.slug].name}>
              {t.treatments.items[tr.slug].name}
            </option>
          ))
        }
        <option value={f.treatmentOther} data-tr={trDict.contact.form.treatmentOther}>{f.treatmentOther}</option>
      </select>
    </div>
    <div class="field cform__full">
      <label for="cf-message">{f.message}</label>
      <textarea id="cf-message" name="message" class="input" rows="5" maxlength="1000" placeholder={f.messagePlaceholder}></textarea>
    </div>
  </div>

  <label class="cform__consent">
    <input type="checkbox" name="consent" value="yes" required />
    <span>
      {f.consent}
      <a href={localizePath(lang, 'kvkk')} class="link" target="_blank">{f.consentLink}</a>
    </span>
  </label>

  <button type="submit" class="btn btn--whatsapp btn--block">
    <Icon name="whatsapp" size={18} />
    {f.submit}
  </button>

  <div class="cform__success" data-success tabindex="-1" hidden>
    <span class="cform__success-icon"><Icon name="check" size={28} /></span>
    <h3>{f.successTitle}</h3>
    <p class="muted">{f.successBody}</p>
    <!-- Sohbet kendiliğinden açılmadıysa (açılır pencere engeli): href, gönderilen mesajla güncellenir -->
    <a href={waBase} class="btn btn--whatsapp" target="_blank" rel="noopener" data-wa-open>
      <Icon name="whatsapp" size={18} />
      {t.common.whatsapp}
    </a>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const success = form.querySelector<HTMLElement>('[data-success]')!;
    const openLink = form.querySelector<HTMLAnchorElement>('[data-wa-open]')!;
    const base = form.dataset.wa ?? '';
    const labels = JSON.parse(form.dataset.labels ?? '{}') as Record<
      'intro' | 'source' | 'name' | 'phone' | 'email' | 'country' | 'treatment' | 'message',
      string
    >;

    /** Boş alan için satır eklenmez */
    const line = (label: string, value: string) => (value ? `${label}: ${value}` : '');

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const get = (name: string) => String(data.get(name) ?? '').trim();

      // Tedavi adı ziyaretçinin dilinde gelir; klinik ekibi için Türkçesi de yanına yazılır
      const select = form.elements.namedItem('treatment') as HTMLSelectElement;
      const turkish = select.selectedOptions[0]?.dataset.tr ?? '';
      const treatment = get('treatment');
      const treatmentText = treatment && turkish && turkish !== treatment ? `${treatment} (${turkish})` : treatment;

      const fields = [
        line(labels.name, get('name')),
        line(labels.phone, get('phone')),
        line(labels.email, get('email')),
        line(labels.country, get('country')),
        line(labels.treatment, treatmentText),
        line(labels.message, get('message')),
      ].filter(Boolean);

      const url = `${base}?text=${encodeURIComponent([labels.intro, '', labels.source, ...fields].join('\n'))}`;
      openLink.href = url;
      window.open(url, '_blank', 'noopener');

      // Kişisel bilgiler ortak bilgisayarda formda kalmasın
      form.reset();
      form.classList.add('is-sent');
      success.hidden = false;
      success.focus();
    });
  });
</script>

<style>
  .cform {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--pearl);
    box-shadow: var(--shadow-md);
  }

  .cform__head {
    display: grid;
    gap: 0.5rem;
  }

  .cform__head h2 {
    font-size: var(--text-2xl);
  }

  .cform__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .cform__full {
    grid-column: 1 / -1;
  }

  .cform__consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .cform__consent input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 0.15rem;
    accent-color: var(--brand-600);
  }

  .cform__consent .link {
    margin-left: 0.25rem;
  }

  .cform__success {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    padding: 2rem;
    border-radius: inherit;
    background: var(--pearl);
    text-align: center;
    animation: cform-in var(--dur-slow) var(--ease-out);
  }

  .cform__success[hidden] {
    display: none;
  }

  .cform__success-icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--brand-600);
    color: #fff;
    box-shadow: var(--glow-brand);
  }

  @keyframes cform-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  @media (max-width: 600px) {
    .cform__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
