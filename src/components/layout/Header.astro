---
/**
 * Sabit üst menü. Sayfa kaydırılınca buzlu cam zemine geçer (main.ts → .is-scrolled).
 * Masaüstünde "Tedaviler" üzerine gelince açılan geniş menü; mobilde tam ekran menü.
 *
 * `onDark`: sayfa koyu, tam genişlik fotoğraflı bir başlıkla açılıyorsa menü en üstteyken
 * beyaz logo ve beyaz yazıyla görünür; kaydırınca ya da mobil menü açılınca normale döner.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo.png';
import logoWhite from '@/assets/brand/logo-white.png';
import Icon from '@/components/ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { treatments } from '@/data/treatments';
import { site, links } from '@/config/site';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  path: string;
  onDark?: boolean;
}

const { lang, path, onDark = false } = Astro.props;
const t = getDictionary(lang);
const to = (p = '') => localizePath(lang, p);
const section = path.split('/')[0] ?? '';

const nav = [
  { key: '', label: t.nav.home },
  { key: 'about', label: t.nav.about },
  { key: 'treatments', label: t.nav.treatments, mega: true },
  { key: 'gallery', label: t.nav.gallery },
  { key: 'contact', label: t.nav.contact },
];
---

<header class:list={['header', onDark && 'header--on-dark']} data-header>
  <div class="header__bar container">
    <a href={to()} class="header__logo" aria-label={`${site.legalName} — ${t.nav.home}`}>
      <Image src={logo} alt="" width={150} densities={[1, 2]} loading="eager" class="header__logo-color" />
      {onDark && <Image src={logoWhite} alt="" width={150} densities={[1, 2]} loading="eager" class="header__logo-white" />}
    </a>

    <nav class="nav" aria-label={t.nav.menu}>
      <ul class="nav__list" role="list">
        {
          nav.map((item) => (
            <li class:list={['nav__item', { 'nav__item--mega': item.mega }]}>
              <a
                href={to(item.key)}
                class="nav__link"
                aria-current={section === item.key ? 'page' : undefined}
              >
                {item.label}
                {item.mega && <Icon name="chevronDown" size={14} />}
              </a>
              {item.mega && (
                <div class="mega">
                  <div class="mega__panel">
                    <ul class="mega__grid" role="list">
                      {treatments.map((tr) => (
                        <li>
                          <a href={to(`treatments/${tr.slug}`)} class="mega__link">
                            <span class="mega__icon">
                              <Icon name={tr.icon} size={22} />
                            </span>
                            <span>
                              <span class="mega__name">{t.treatments.items[tr.slug].name}</span>
                              <span class="mega__short">{t.treatments.items[tr.slug].short}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href={to('treatments')} class="link mega__all">
                      {t.common.allTreatments}
                      <Icon name="arrowRight" size={16} />
                    </a>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LanguageSwitcher lang={lang} path={path} />
      <a href={to('contact')} class="btn btn--primary btn--sm header__cta">{t.nav.cta}</a>
      <button
        type="button"
        class="header__burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menu}
        data-menu-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu inert>
  <div class="mobile-menu__inner container">
    <nav aria-label={t.nav.menu}>
      <ul class="mobile-menu__list" role="list">
        {
          nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={to(item.key)} aria-current={section === item.key ? 'page' : undefined}>
                <span class="mobile-menu__index">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-menu__foot">
      <LanguageSwitcher lang={lang} path={path} variant="pills" />
      <div class="mobile-menu__contact">
        <a href={links.whatsapp(t.common.whatsappMessage)} class="btn btn--whatsapp" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          {t.common.whatsapp}
        </a>
        <a href={links.tel} class="btn btn--ghost">
          <Icon name="phone" size={18} />
          {t.common.call}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    transition:
      background-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      backdrop-filter var(--dur) var(--ease-out);
  }

  .header.is-scrolled {
    background: rgba(250, 248, 244, 0.82);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    box-shadow: 0 1px 0 var(--line);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: 100%;
  }

  .header__logo {
    flex: none;
    display: block;
  }

  .header__logo :global(img) {
    width: clamp(118px, 10vw, 150px);
    height: auto;
  }

  .header__logo :global(.header__logo-white) {
    display: none;
  }

  /* ---------- Koyu fotoğraflı başlığın üzerindeyken (en üstte, mobil menü kapalı) ---------- */
  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) :global(.header__logo-color) {
    display: none;
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) :global(.header__logo-white) {
    display: block;
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) .nav__link {
    color: rgba(255, 255, 255, 0.9);
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) .nav__link:hover,
  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) .nav__link[aria-current='page'] {
    color: #fff;
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) .nav__link::after {
    background: var(--champagne-soft);
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) :global(.lang__toggle) {
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) :global(.lang__toggle:hover),
  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) :global(.lang[open] .lang__toggle) {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.12);
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) .header__burger {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.12);
  }

  :global(html:not(.menu-open)) .header--on-dark:not(.is-scrolled) .header__burger span {
    background: #fff;
  }

  /* ---------- Masaüstü menü ---------- */
  /* Öğeler başlık yüksekliğini doldurur; böylece geniş menüye inerken hover kopmaz */
  .nav,
  .nav__list,
  .nav__item {
    height: 100%;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 2rem);
    margin: 0;
  }

  .nav__item {
    display: flex;
    align-items: center;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.2rem;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ink);
    transition: color var(--dur) var(--ease-out);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.2rem;
    right: 0.2rem;
    bottom: 0.25rem;
    height: 1px;
    background: var(--brand-600);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--brand-700);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__item--mega {
    position: static;
  }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding-top: 0.25rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  .nav__item--mega:hover .mega,
  .nav__item--mega:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mega__panel {
    width: min(var(--container), calc(100% - var(--gutter) * 2));
    margin-inline: auto;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(20px);
    box-shadow: var(--shadow-lg);
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0 0 1.25rem;
  }

  .mega__link {
    display: flex;
    gap: 0.9rem;
    padding: 0.9rem;
    border-radius: var(--radius-md);
    transition: background-color var(--dur-fast);
  }

  .mega__link:hover {
    background: var(--brand-50);
  }

  .mega__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-600);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }

  .mega__link:hover .mega__icon {
    background: var(--brand-600);
    color: #fff;
  }

  .mega__name {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .mega__short {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .mega__all {
    margin-left: 0.9rem;
  }

  /* ---------- Sağ taraf ---------- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__burger {
    display: none;
    position: relative;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
  }

  .header__burger span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform var(--dur) var(--ease-out),
      top var(--dur) var(--ease-out);
  }

  .header__burger span:first-child {
    top: 18px;
  }

  .header__burger span:last-child {
    top: 26px;
  }

  :global(html.menu-open) .header__burger span:first-child {
    top: 22px;
    transform: rotate(45deg);
  }

  :global(html.menu-open) .header__burger span:last-child {
    top: 22px;
    transform: rotate(-45deg);
  }

  @media (max-width: 1100px) {
    .mega__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 980px) {
    .nav,
    .header__cta {
      display: none;
    }

    .header__burger {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .header__actions :global(.lang) {
      display: none;
    }
  }

  /* ---------- Mobil menü ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-header) - 1);
    padding-top: var(--header-h);
    background:
      radial-gradient(80% 50% at 100% 0%, rgba(76, 195, 224, 0.14), transparent 60%),
      var(--ivory);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 700ms var(--ease-in-out),
      visibility 0s linear 700ms;
    overflow-y: auto;
  }

  :global(html.menu-open) .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 700ms var(--ease-in-out),
      visibility 0s;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  :global(html.menu-open) .header {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--space-6) var(--space-7);
  }

  .mobile-menu__list {
    margin: 0;
  }

  .mobile-menu__list li {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 500ms var(--ease-out),
      transform 600ms var(--ease-out);
  }

  :global(html.menu-open) .mobile-menu__list li {
    opacity: 1;
    transform: none;
    transition-delay: calc(250ms + var(--i) * 60ms);
  }

  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 2.75rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .mobile-menu__list a[aria-current='page'] {
    color: var(--brand-600);
    font-style: italic;
  }

  .mobile-menu__index {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--champagne);
  }

  .mobile-menu__foot {
    display: grid;
    gap: var(--space-5);
  }

  .mobile-menu__contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 981px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
