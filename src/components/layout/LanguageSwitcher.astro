---
/**
 * Dil seçici — aynı sayfanın diğer dildeki karşılığına götürür.
 * <details> ile çalıştığı için JavaScript olmadan da açılır.
 */
import Icon from '@/components/ui/Icon.astro';
import Flag from '@/components/ui/Flag.astro';
import { alternatePaths, getDictionary, localeMeta, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  path: string;
  variant?: 'dropdown' | 'pills';
}

const { lang, path, variant = 'dropdown' } = Astro.props;
const t = getDictionary(lang);
const options = alternatePaths(path);
---

{
  variant === 'dropdown' ? (
    <details class="lang" data-lang-menu>
      <summary class="lang__toggle" aria-label={`${t.nav.language}: ${localeMeta[lang].nativeName}`}>
        <Flag code={lang} size={18} class="lang__flag" />
        <span>{localeMeta[lang].short}</span>
        <Icon name="chevronDown" size={14} class="lang__chevron" />
      </summary>
      <ul class="lang__list" role="list">
        {options.map(({ locale, href }) => (
          <li>
            <a
              href={href}
              hreflang={localeMeta[locale].htmlLang}
              lang={localeMeta[locale].htmlLang}
              class:list={['lang__option', { 'is-current': locale === lang }]}
              aria-current={locale === lang ? 'true' : undefined}
              data-lang-switch={locale}
            >
              <Flag code={locale} size={18} class="lang__flag" />
              <span>{localeMeta[locale].nativeName}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <ul class="lang-pills" role="list" aria-label={t.nav.language}>
      {options.map(({ locale, href }) => (
        <li>
          <a
            href={href}
            hreflang={localeMeta[locale].htmlLang}
            lang={localeMeta[locale].htmlLang}
            class:list={['lang-pills__item', { 'is-current': locale === lang }]}
            aria-current={locale === lang ? 'true' : undefined}
            aria-label={localeMeta[locale].nativeName}
            data-lang-switch={locale}
          >
            <Flag code={locale} size={18} class="lang-pills__flag" />
            {localeMeta[locale].short}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .lang {
    position: relative;
  }

  .lang__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 42px;
    padding: 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    list-style: none;
    cursor: pointer;
    user-select: none;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .lang__toggle::-webkit-details-marker {
    display: none;
  }

  .lang__toggle:hover,
  .lang[open] .lang__toggle {
    border-color: var(--brand-300);
    background: rgba(255, 255, 255, 0.7);
  }

  .lang :global(.lang__chevron) {
    transition: transform var(--dur) var(--ease-out);
  }

  .lang[open] :global(.lang__chevron) {
    transform: rotate(180deg);
  }

  .lang__list {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 190px;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-md);
    animation: lang-in var(--dur) var(--ease-out);
  }

  .lang__option {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }

  .lang__option:hover {
    background: var(--brand-50);
    color: var(--ink);
  }

  .lang__option.is-current {
    color: var(--brand-700);
    font-weight: 600;
  }

  .lang__flag {
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--line);
  }

  @keyframes lang-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .lang-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .lang-pills__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 52px;
    height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .lang-pills__flag {
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .lang-pills__item.is-current {
    border-color: var(--brand-600);
    background: var(--brand-600);
    color: #fff;
  }
</style>
