---
/**
 * Sabit iletişim butonları:
 *  - WhatsApp: her ekranda sağ altta
 *  - Ara: yalnızca mobilde (≤ 860px) sol altta
 */
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/config/site';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
---

<div class="float">
  <a
    href={links.whatsapp(t.common.whatsappMessage)}
    class="float__btn float__btn--wa"
    target="_blank"
    rel="noopener"
    aria-label={t.common.whatsapp}
  >
    <span class="float__pulse" aria-hidden="true"></span>
    <Icon name="whatsapp" size={26} />
    <span class="float__label">{t.common.whatsapp}</span>
  </a>

  <a href={links.tel} class="float__btn float__btn--call" aria-label={t.common.call}>
    <Icon name="phone" size={24} />
  </a>
</div>

<style>
  .float__btn {
    position: fixed;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: var(--z-float);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    min-width: 60px;
    border-radius: var(--radius-pill);
    color: #fff;
    box-shadow: 0 18px 40px -16px rgba(5, 34, 50, 0.55);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .float__btn:hover {
    transform: translateY(-3px);
  }

  .float__btn--wa {
    right: max(1.25rem, env(safe-area-inset-right));
    padding: 0 1.05rem;
    gap: 0;
    background: #1f9d55;
  }

  .float__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      max-width 500ms var(--ease-out),
      margin 500ms var(--ease-out);
  }

  @media (hover: hover) {
    .float__btn--wa:hover .float__label {
      max-width: 120px;
      margin-left: 0.6rem;
    }
  }

  .float__pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #1f9d55;
    animation: float-pulse 2.8s var(--ease-out) infinite;
    pointer-events: none;
  }

  @keyframes float-pulse {
    0% {
      opacity: 0.7;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  .float__btn--call {
    display: none;
    left: max(1.25rem, env(safe-area-inset-left));
    background: var(--brand-600);
  }

  @media (max-width: 860px) {
    .float__btn--call {
      display: inline-flex;
    }

    /* Ara solda, WhatsApp sağda: iki küçük, şeffaf geçişli cam buton. Girişte ayrıca büyük buton yok, hep görünürler */
    .float__btn {
      bottom: max(1rem, env(safe-area-inset-bottom));
      height: 48px;
      min-width: 48px;
      border: 1px solid rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(14px) saturate(160%);
      -webkit-backdrop-filter: blur(14px) saturate(160%);
      box-shadow:
        0 12px 26px -14px rgba(5, 34, 50, 0.55),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    .float__btn :global(.icon) {
      width: 22px;
      height: 22px;
    }

    .float__btn--wa {
      right: max(1rem, env(safe-area-inset-right));
      padding: 0;
      background: linear-gradient(135deg, rgba(42, 196, 108, 0.92), rgba(22, 132, 72, 0.82));
    }

    .float__btn--call {
      left: max(1rem, env(safe-area-inset-left));
      border-color: rgba(255, 255, 255, 0.8);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.5));
      color: var(--brand-700);
    }
  }

  :global(html.menu-open) .float__btn {
    opacity: 0;
    pointer-events: none;
  }
</style>
