---
/**
 * Açılış perdesi: logo soldan ışıkla belirir, ardından perde yukarı kalkar.
 * Oturum başına bir kez oynar; hareket azaltma tercihi olanlarda hiç görünmez.
 * Hangi durumda oynayacağına BaseLayout içindeki satır içi betik karar verir
 * (<html class="intro-play">). Tamamen CSS ile çalışır.
 */
import { getImage } from 'astro:assets';
import logo from '@/assets/brand/logo.png';

const logoImg = await getImage({ src: logo, width: 560, format: 'png' });
---

<div class="intro" aria-hidden="true">
  <div class="intro__mark" style={`--logo-url: url("${logoImg.src}")`}>
    <img src={logoImg.src} alt="" width="280" height={Math.round((280 * logo.height) / logo.width)} />
  </div>
  <span class="intro__line"></span>
</div>

<style>
  .intro {
    display: none;
  }

  :global(html.intro-play) .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.75rem;
    background:
      radial-gradient(60% 50% at 50% 45%, rgba(76, 195, 224, 0.1), transparent 70%),
      var(--ivory);
    animation: intro-lift 1.1s var(--ease-in-out) 2s forwards;
  }

  .intro__mark {
    position: relative;
    width: min(280px, 64vw);
    clip-path: inset(0 100% 0 0);
    animation: intro-reveal 1.2s var(--ease-out) 0.25s forwards;
  }

  .intro__mark img {
    width: 100%;
    height: auto;
  }

  /* Logonun yalnızca kendi şekli üzerinde kayan ışık */
  .intro__mark::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgba(255, 255, 255, 0.95) 50%, transparent 65%) no-repeat;
    background-size: 250% 100%;
    background-position: 150% 0;
    -webkit-mask: var(--logo-url) center / contain no-repeat;
    mask: var(--logo-url) center / contain no-repeat;
    animation: intro-sheen 1.1s var(--ease-in-out) 1.05s forwards;
  }

  .intro__line {
    display: block;
    width: 140px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--champagne), transparent);
    transform: scaleX(0);
    animation: intro-line 1s var(--ease-out) 0.9s forwards;
  }

  @keyframes intro-reveal {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes intro-sheen {
    to {
      background-position: -50% 0;
    }
  }

  @keyframes intro-line {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes intro-lift {
    0% {
      clip-path: inset(0 0 0 0);
    }
    99% {
      visibility: visible;
    }
    100% {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
