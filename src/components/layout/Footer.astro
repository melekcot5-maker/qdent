---
import { Image } from 'astro:assets';
import logoWhite from '@/assets/brand/logo-white.png';
import Icon from '@/components/ui/Icon.astro';
import OpeningHours from '@/components/ui/OpeningHours.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { treatments } from '@/data/treatments';
import { site, links, fullAddress } from '@/config/site';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const t = getDictionary(lang);
const to = (p = '') => localizePath(lang, p);
const year = new Date().getFullYear();

const explore = [
  { href: to(), label: t.nav.home },
  { href: to('about'), label: t.nav.about },
  { href: to('treatments'), label: t.nav.treatments },
  { href: to('gallery'), label: t.nav.gallery },
  { href: to('contact'), label: t.nav.contact },
];
---

<footer class="footer">
  <div class="footer__glow" aria-hidden="true"></div>

  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={to()} aria-label={site.legalName}>
        <Image src={logoWhite} alt="" width={180} densities={[1, 2]} />
      </a>
      <p class="footer__tagline">{t.footer.tagline}</p>
      <div class="footer__social" aria-label={t.common.followUs}>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <Icon name="instagram" size={20} />
        </a>
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <Icon name="facebook" size={20} />
        </a>
        <a href={links.whatsapp(t.common.whatsappMessage)} target="_blank" rel="noopener" aria-label="WhatsApp">
          <Icon name="whatsapp" size={18} />
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label={t.footer.explore}>
      <h2 class="footer__title">{t.footer.explore}</h2>
      <ul role="list">
        {explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label={t.footer.treatments}>
      <h2 class="footer__title">{t.footer.treatments}</h2>
      <ul role="list">
        {
          treatments.map((tr) => (
            <li>
              <a href={to(`treatments/${tr.slug}`)}>{t.treatments.items[tr.slug].name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col footer__contact">
      <h2 class="footer__title">{t.footer.contact}</h2>
      <ul role="list">
        <li>
          <Icon name="pin" size={18} />
          <a href={links.directions} target="_blank" rel="noopener">{fullAddress}</a>
        </li>
        <li>
          <Icon name="phone" size={18} />
          <span>
            <a href={links.tel}>{site.phone.display}</a><br />
            <a href={links.landline}>{site.landline.display}</a>
          </span>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <a href={links.mailto}>{site.email}</a>
        </li>
      </ul>
      <OpeningHours lang={lang} tone="dark" />
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {site.legalName}. {t.footer.rights}</p>
    <div class="footer__bottom-links">
      <a href={to('privacy')}>{t.footer.privacy}</a>
      <LanguageSwitcher lang={lang} path={path} variant="pills" />
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
    background: var(--brand-950);
    color: var(--on-dark);
  }

  .footer__glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(closest-side, rgba(76, 195, 224, 0.16), transparent);
    pointer-events: none;
  }

  .footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr 1.3fr;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .footer__brand :global(img) {
    width: 180px;
    height: auto;
  }

  .footer__tagline {
    max-width: 280px;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--on-dark);
  }

  .footer__social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-on-dark);
    border-radius: 50%;
    color: var(--on-dark);
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .footer__social a:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .footer__title {
    margin-bottom: 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champagne-soft);
  }

  .footer__col ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    font-size: var(--text-sm);
  }

  .footer__col a {
    color: var(--on-dark-soft);
    transition: color var(--dur-fast);
  }

  .footer__col a:hover {
    color: #fff;
  }

  .footer__contact ul {
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .footer__contact li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    line-height: 1.6;
  }

  .footer__contact li :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--brand-300);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line-on-dark);
    font-size: var(--text-xs);
    color: var(--on-dark-soft);
  }

  .footer__bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .footer__bottom-links > a:hover {
    color: #fff;
  }

  .footer__bottom :global(.lang-pills__item) {
    min-width: 40px;
    height: 32px;
    padding: 0 0.6rem;
    border-color: var(--line-on-dark);
    color: var(--on-dark-soft);
  }

  .footer__bottom :global(.lang-pills__item.is-current) {
    border-color: #fff;
    background: #fff;
    color: var(--brand-900);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer {
      padding-bottom: 5rem;
    }
  }
</style>
