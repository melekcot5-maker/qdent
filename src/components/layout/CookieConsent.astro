---
/**
 * Çerez bildirimi (ilk ziyarette) ve tercih paneli (alt bilgideki "Çerez Tercihleri" ile açılır).
 * Davranış src/scripts/consent.ts içinde; JS kapalıysa bildirim çıkmaz ve harici içerik de yüklenmez.
 */
import Icon from '@/components/ui/Icon.astro';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = getDictionary(lang).consent;
---

<section class="consent" data-consent-banner hidden aria-labelledby="consent-banner-title">
  <h2 class="consent__title" id="consent-banner-title">{c.banner.title}</h2>
  <p class="consent__text">
    {c.banner.text}{' '}
    <a href={localizePath(lang, 'cookies')} class="consent__policy">{c.banner.policy}</a>
  </p>
  <div class="consent__actions">
    <!-- KVKK rehberi: reddetmek kabul etmek kadar kolay ve görünür olmalı -->
    <button type="button" class="btn btn--sm btn--primary" data-consent-choice="reject">{c.banner.reject}</button>
    <button type="button" class="btn btn--sm btn--primary" data-consent-choice="accept">{c.banner.accept}</button>
    <button type="button" class="consent__more" data-consent-open>{c.banner.settings}</button>
  </div>
</section>

<dialog class="consent-dialog" data-consent-dialog aria-labelledby="consent-dialog-title">
  <form method="dialog" class="consent-dialog__inner">
    <header class="consent-dialog__head">
      <h2 id="consent-dialog-title">{c.dialog.title}</h2>
      <button type="submit" value="cancel" class="consent-dialog__close" aria-label={c.dialog.close}>
        <Icon name="close" size={20} />
      </button>
    </header>
    <p class="consent-dialog__intro">{c.dialog.intro}</p>

    <ul class="consent-options" role="list">
      <li class="consent-option">
        <div>
          <h3>{c.dialog.necessaryTitle}</h3>
          <p>{c.dialog.necessaryBody}</p>
        </div>
        <span class="consent-option__badge">{c.dialog.alwaysOn}</span>
      </li>
      <li class="consent-option">
        <div>
          <h3 id="consent-external-title">{c.dialog.externalTitle}</h3>
          <p>{c.dialog.externalBody}</p>
        </div>
        <label class="switch">
          <input type="checkbox" data-consent-external aria-labelledby="consent-external-title" />
          <span class="switch__track" aria-hidden="true"></span>
        </label>
      </li>
    </ul>

    <div class="consent-dialog__actions">
      <button type="button" class="btn btn--sm btn--ghost" data-consent-choice="reject">{c.dialog.rejectAll}</button>
      <button type="button" class="btn btn--sm btn--ghost" data-consent-choice="accept">{c.dialog.acceptAll}</button>
      <button type="button" class="btn btn--sm btn--primary" data-consent-save>{c.dialog.save}</button>
    </div>
  </form>
</dialog>

<style>
  .consent {
    position: fixed;
    left: max(1.25rem, env(safe-area-inset-left));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: calc(var(--z-float) + 1);
    display: grid;
    gap: 0.75rem;
    width: min(440px, calc(100vw - 2.5rem));
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--pearl);
    box-shadow: var(--shadow-lg);
  }

  .consent[hidden] {
    display: none;
  }

  .consent__title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0;
  }

  .consent__text {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .consent__policy {
    font-weight: 600;
    color: var(--brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .consent__actions .btn {
    flex: 1 1 0;
  }

  .consent__more {
    flex-basis: 100%;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Mobilde sabit WhatsApp / Ara butonlarının üstünde durur */
  @media (max-width: 860px) {
    .consent {
      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(56px + 1.25rem + 0.75rem);
      width: auto;
      padding: 1.15rem 1.2rem;
    }
  }

  :global(html.menu-open) .consent {
    display: none;
  }

  /* ---------- Tercih paneli ---------- */
  .consent-dialog {
    width: min(560px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--pearl);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
  }

  .consent-dialog::backdrop {
    background: rgba(5, 34, 50, 0.45);
    backdrop-filter: blur(3px);
  }

  .consent-dialog__inner {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
  }

  .consent-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .consent-dialog__head h2 {
    font-size: var(--text-xl);
  }

  .consent-dialog__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: none;
  }

  .consent-dialog__intro {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .consent-options {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .consent-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ivory);
  }

  .consent-option h3 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .consent-option p {
    margin-top: 0.25rem;
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .consent-option__badge {
    flex: none;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--brand-700);
    white-space: nowrap;
  }

  .switch {
    position: relative;
    flex: none;
    width: 48px;
    height: 28px;
    cursor: pointer;
  }

  .switch input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .switch__track {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: var(--sand-200);
    transition: background-color var(--dur) var(--ease-out);
    pointer-events: none;
  }

  .switch__track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out);
  }

  .switch input:checked + .switch__track {
    background: var(--brand-600);
  }

  .switch input:checked + .switch__track::after {
    transform: translateX(20px);
  }

  .switch input:focus-visible + .switch__track {
    outline: 2px solid var(--brand-600);
    outline-offset: 3px;
  }

  .consent-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  @media (max-width: 520px) {
    .consent-dialog__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
