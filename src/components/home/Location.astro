---
import { Image } from 'astro:assets';
import coast from '@/assets/images/oludeniz-coast.jpg';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/config/site';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const c = t.home.location;
---

<section class="location">
  <div class="location__media" aria-hidden="true">
    <div class="location__img" data-parallax="0.12">
      <Image src={coast} alt="" widths={[800, 1200, 1600, 2400]} sizes="100vw" />
    </div>
  </div>

  <div class="container location__inner">
    <div class="location__card" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="muted">{c.body}</p>
      <ul class="location__points" role="list">
        {
          c.points.map((point) => (
            <li>
              <Icon name="check" size={18} />
              {point}
            </li>
          ))
        }
      </ul>
      <div class="location__actions">
        <a href={localizePath(lang, 'contact') + '#map'} class="btn btn--primary">
          <Icon name="pin" size={18} />
          {c.cta}
        </a>
        <a href={links.directions} class="btn btn--ghost" target="_blank" rel="noopener">
          {t.common.directions}
          <Icon name="arrowUpRight" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    position: relative;
    overflow: hidden;
    padding-block: clamp(6rem, 4rem + 10vw, 14rem);
  }

  .location__media {
    position: absolute;
    inset: 0;
  }

  .location__img {
    position: absolute;
    inset: -12% 0;
  }

  .location__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .location__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(5, 34, 50, 0.35), transparent 60%);
  }

  .location__inner {
    position: relative;
  }

  .location__card {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 560px;
    padding: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-xl);
    background: rgba(250, 248, 244, 0.86);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: var(--shadow-lg);
  }

  .location__points {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    font-size: var(--text-sm);
  }

  .location__points li {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .location__points :global(.icon) {
    flex: none;
    color: var(--brand-600);
  }

  .location__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-2);
  }
</style>
