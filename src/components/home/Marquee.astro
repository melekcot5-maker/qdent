---
/** Tedavi adlarının yavaşça kaydığı zarif şerit (dekoratif). */
import Icon from '@/components/ui/Icon.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const words = getDictionary(Astro.props.lang).home.marquee;
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <ul class="marquee__group" role="list">
          {words.map((w) => (
            <li>
              <span>{w}</span>
              <Icon name="sparkles" size={18} />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 1.75rem;
    border-block: 1px solid var(--line);
    background: var(--pearl);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    margin: 0;
  }

  .marquee__group li {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem);
    font-style: italic;
    color: var(--ink);
    white-space: nowrap;
  }

  .marquee__group li :global(.icon) {
    color: var(--champagne);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
