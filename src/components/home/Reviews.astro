---
/**
 * Hasta yorumları: Google puanı ve yorumlara bağlantı.
 * Sahte yorum yayınlamamak için metin yerine gerçek Google sayfasına yönlendirir.
 */
import Icon from '@/components/ui/Icon.astro';
import { site, links } from '@/config/site';
import { format, getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const c = t.home.reviews;
const rating = site.google.rating.toLocaleString(lang, { minimumFractionDigits: 1 });
---

<section class="section reviews">
  <div class="container container--narrow reviews__inner">
    <p class="eyebrow eyebrow--center" data-reveal>{c.eyebrow}</p>

    <div class="reviews__score" data-reveal="scale" style="--d: 1">
      <span class="reviews__value">{rating}</span>
      <span class="reviews__meta">
        <span class="reviews__stars" aria-hidden="true">
          {Array.from({ length: 5 }, () => <Icon name="star" size={20} />)}
        </span>
        <span>Google · {format(t.common.googleReviews, { count: site.google.reviewCount })}</span>
      </span>
    </div>

    <h2 data-reveal style="--d: 2">{c.title}</h2>
    <p class="lead" data-reveal style="--d: 3">{c.body}</p>

    <div class="reviews__actions" data-reveal style="--d: 4">
      <a href={links.reviews} class="btn btn--primary" target="_blank" rel="noopener">
        {c.cta}
        <Icon name="arrowUpRight" size={16} />
      </a>
      <a href={links.writeReview} class="btn btn--ghost" target="_blank" rel="noopener">{c.write}</a>
    </div>
  </div>
</section>

<style>
  .reviews {
    overflow: hidden;
  }

  .reviews::before {
    content: '“';
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -8%;
    font-family: var(--font-display);
    font-size: clamp(16rem, 10rem + 20vw, 30rem);
    line-height: 1;
    color: var(--brand-50);
    pointer-events: none;
  }

  .reviews__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .reviews__score {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-block: var(--space-2);
  }

  .reviews__value {
    font-family: var(--font-sans);
    font-size: clamp(3.4rem, 2.6rem + 3.4vw, 5.5rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: var(--brand-700);
  }

  .reviews__meta {
    display: grid;
    gap: 0.35rem;
    text-align: left;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .reviews__stars {
    display: flex;
    gap: 3px;
    color: var(--champagne);
  }

  .reviews__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: var(--space-2);
  }
</style>
