---
/**
 * Ana sayfa girişi: kliniğin girişi tam genişlik arka planda, üzerinde soldan sağa açılan lacivert
 * geçiş; menü bu sayfada en üstteyken beyaz görünür (index.astro → BaseLayout darkHero).
 * Mobilde fotoğraf üstte açık kalır, yazı onun üzerine binen lacivert panele geçer.
 */
import { Image } from 'astro:assets';
// Mankenli stok fotoğraf yerine kliniğin kendi girişi: yönetmelik yanıltıcı görsel kullanımını yasaklıyor
import entrance from '@/assets/images/clinic/entrance.jpg';
import mark from '@/assets/brand/logo-mark.png';
import Icon from '@/components/ui/Icon.astro';
import { site, links } from '@/config/site';
import { getTreatment, type TreatmentSlug } from '@/data/treatments';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const h = t.home.hero;

/**
 * Girişte ilk bakışta diş kliniği olduğu anlaşılsın diye öne çıkan tedaviler. Yalnızca hizmetin adı
 * (yönetmelik sunulan hizmetlerin bilgisine izin verir); fiyat veya sonuç iddiası eklenmemeli.
 */
const featured: TreatmentSlug[] = ['dental-implants', 'smile-design', 'zirconia-crowns', 'root-canal-treatment'];
const chips = featured.flatMap((slug) => getTreatment(slug) ?? []);
---

<section class="hero">
  <!-- Yalnızca mobilde: kemer fotoğrafın dışında kalan koyu zemini süsleyen ince çizgi motifleri -->
  <div class="hero__deco" aria-hidden="true">
    <span class="deco deco--icon deco--implant"><Icon name="implant" size={26} /></span>
    <span class="deco deco--icon deco--brush"><Icon name="toothbrush" size={28} /></span>
    <span class="deco deco--icon deco--t1"><Icon name="veneer" size={30} /></span>
    <span class="deco deco--icon deco--t2"><Icon name="sparkle" size={32} /></span>
    <span class="deco deco--spark deco--s1"><Icon name="sparkles" size={13} /></span>
    <span class="deco deco--spark deco--s2"><Icon name="sparkles" size={12} /></span>
    <span class="deco deco--text deco--text-l" lang="en">Quality Dental Center</span>
    <span class="deco deco--text deco--text-r">Ölüdeniz · Fethiye</span>
  </div>
  <!-- Paralaks kaydırırken kenar boşluğu görünmesin diye arka plan bölümden biraz taşar -->
  <div class="hero__bg" data-parallax="0.1" aria-hidden="true">
    <Image src={entrance} alt="" widths={[768, 1280, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- Marka adı İngilizce işaretlenir; aksi halde Türkçe büyük harf dönüşümü "QUALİTY" yazar -->
      <p class="eyebrow" data-hero style="--h: 0"><span><span class="hero__brand" lang="en">Quality Dental Center · </span>{h.eyebrow}</span></p>

      <h1 class="hero__title">
        <span class="hero__line"><span data-hero-line style="--h: 1">{h.titleTop}</span></span>
        <span class="hero__line">
          <span data-hero-line style="--h: 2"><em>{h.titleAccent}</em> {h.titleBottom}</span>
        </span>
      </h1>

      <p class="lead hero__lead" data-hero style="--h: 4">{h.lead}</p>

      <!-- Mobilde gizli: Ara/WhatsApp orada sağ/sol altta sabit durur (FloatingActions) -->
      <div class="hero__actions" data-hero style="--h: 5">
        <a href={links.whatsapp(t.common.whatsappMessage)} class="btn btn--primary" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          {h.primaryCta}
        </a>
        <a href={localizePath(lang, 'treatments')} class="btn btn--outline-light">
          {h.secondaryCta}
          <Icon name="arrowRight" size={16} class="icon--arrow" />
        </a>
      </div>

      <nav class="hero__treatments" data-hero style="--h: 6" aria-label={t.home.treatments.eyebrow}>
        <ul role="list">
          {
            chips.map((tr) => (
              <li>
                <a href={localizePath(lang, `treatments/${tr.slug}`)}>
                  <span class="hero__chip-icon" aria-hidden="true">
                    <Icon name={tr.icon} size={16} />
                  </span>
                  {t.treatments.items[tr.slug].name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Sağ altta mühür: dönen marka yazısı içinde Q logosu, yanında deneyim yılı -->
    <div class="hero__seal" data-hero style="--h: 7">
      <div class="seal" aria-hidden="true">
        <svg class="seal__ring" viewBox="0 0 200 200">
          <defs>
            <path id="hero-seal-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
          </defs>
          <!-- textLength çemberin çevresine (2π·78 ≈ 490) eşit: yazı boşluksuz ve eşit aralıkla tam tur atar -->
          <text><textPath href="#hero-seal-path" textLength="488" lengthAdjust="spacing">QUALITY DENTAL CENTER · ÖLÜDENİZ · FETHİYE ·</textPath></text>
        </svg>
        <span class="seal__core">
          <Image src={mark} alt="" width={40} densities={[1, 2]} />
        </span>
      </div>
      <div class="seal__stat">
        <strong>{site.experienceYears}<span>+</span></strong>
        <span class="seal__label">{h.experienceBadge}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(100svh, 980px);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 6rem;
    background: var(--brand-950);
    color: var(--on-dark);
  }

  .hero__deco {
    display: none;
  }

  .hero__bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }

  /*
   * Örnek tasarımdaki gibi lacivert ton: yazının altı koyu, sağa doğru açılır.
   * Üstteki ek koyuluk beyaz menünün okunmasını sağlar.
   */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(5, 34, 50, 0.55) 0%, rgba(5, 34, 50, 0) 26%),
      radial-gradient(60% 70% at 0% 100%, rgba(76, 195, 224, 0.18), transparent 70%),
      linear-gradient(90deg, rgba(5, 34, 50, 0.93) 0%, rgba(5, 34, 50, 0.8) 38%, rgba(8, 51, 74, 0.5) 68%, rgba(8, 51, 74, 0.3) 100%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-6);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 820px;
  }

  .hero__copy > .eyebrow {
    color: var(--champagne-soft);
  }

  .hero__title {
    font-size: clamp(2.3rem, 1.2rem + 4.4vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__title em {
    font-weight: 500;
    background: linear-gradient(100deg, #8fdcf0, #bfe9f4 45%, var(--champagne-soft));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
  }

  .hero__lead {
    max-width: 52ch;
    color: rgba(244, 248, 251, 0.86);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-2);
  }

  /* ---------- Öne çıkan tedaviler: ikonlu buzlu cam çipler ---------- */
  .hero__treatments ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: var(--space-2) 0 0;
  }

  .hero__treatments a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .hero__treatments a:hover {
    border-color: rgba(217, 195, 163, 0.7);
    background: rgba(255, 255, 255, 0.16);
  }

  .hero__chip-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(217, 195, 163, 0.18);
    color: var(--champagne-soft);
  }

  /* ---------- Sağ altta mühür ---------- */
  .hero__seal {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 0.85rem 2rem 0.85rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    /* Lacivert tonlu cam: arkası açık duvar da olsa yazılar aynı netlikte okunur */
    background: linear-gradient(135deg, rgba(8, 51, 74, 0.62), rgba(5, 34, 50, 0.42));
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.55);
  }

  .seal {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 112px;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(217, 195, 163, 0.45);
  }

  .seal__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: seal-spin 40s linear infinite;
  }

  .seal__ring text {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    fill: var(--champagne-soft);
  }

  /* Ortadaki fildişi daire: logo laciverdin üzerinde değil, açık zeminde net görünür */
  .seal__core {
    display: grid;
    place-items: center;
    width: 58px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #fff, var(--ivory) 70%);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.12),
      0 0 0 4px rgba(217, 195, 163, 0.7),
      0 10px 24px -8px rgba(0, 0, 0, 0.5);
  }

  .seal__core :global(img) {
    width: 30px;
    height: auto;
  }

  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .seal__stat {
    display: grid;
    gap: 0.35rem;
    padding-left: 1.4rem;
    border-left: 1px solid rgba(217, 195, 163, 0.45);
  }

  .seal__stat strong {
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 500;
    font-variant-numeric: lining-nums;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .seal__stat strong span {
    margin-left: 0.04em;
    font-style: italic;
    color: var(--champagne-soft);
  }

  .seal__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }

  /* ---------- Giriş animasyonu (perde kalktıktan sonra) ---------- */
  :global(html.js) .hero__bg :global(img) {
    animation: hero-zoom 2.6s var(--ease-out) both;
    animation-delay: var(--intro-delay);
  }

  :global(html.js) [data-hero] {
    animation: hero-rise 1.3s var(--ease-out) both;
    animation-delay: calc(var(--intro-delay) + var(--h) * 110ms);
  }

  :global(html.js) [data-hero-line] {
    animation: hero-line 1.4s var(--ease-out) both;
    animation-delay: calc(var(--intro-delay) + var(--h) * 120ms);
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.1);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__bg :global(img),
    :global(html.js) [data-hero],
    :global(html.js) [data-hero-line],
    .seal__ring,
    .deco {
      animation: none;
    }
  }

  /* ---------- Duyarlı ---------- */
  /*
   * Dar ekranda yazı fotoğrafın tamamını kaplıyor, giriş koyu tonun altında kayboluyordu.
   * Burada fotoğraf üstte açık kalır, yazı ona binen yuvarlak köşeli açık (fildişi) panele geçer;
   * mühür fotoğrafla panelin sınırına oturur. Panel yalnızca içeriği kadar yer kaplar:
   * tek satır buton ve ince mühür sayesinde fotoğraf ekranın büyük kısmını alır.
   *
   * Giriş, altındaki tedavi şeridi (Marquee) ilk ekranda görünecek kadar kısa tutulur.
   * Şeridin yüksekliği değişirse --marquee-h de güncellenmeli.
   */
  @media (max-width: 860px) {
    .hero {
      --marquee-h: 5.75rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(10rem, 1fr) auto;
      align-items: stretch;
      min-height: calc(100svh - var(--marquee-h));
      padding: 0 0 var(--space-4);
      background: var(--ivory);
      color: var(--ink);
    }

    /*
     * Fotoğraf kemer (arch) biçiminde, lacivertten fildişine inen bir zeminin üstünde durur:
     * menü koyu zeminde okunur, aşağıda kemer panele eriyerek karışır. Zemin (.hero__shade) fotoğrafın
     * (.hero__bg) altında kalsın diye z-index'leri mobilde yer değiştirir. İkisi de ilk satırı doldurur
     * ve panelin altına uzanır.
     */
    .hero__bg,
    .hero__shade {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
      margin-bottom: -4rem;
    }

    .hero__shade {
      z-index: -2;
      background:
        radial-gradient(80% 26% at 50% 14%, rgba(76, 195, 224, 0.28), transparent 72%),
        radial-gradient(60% 22% at 100% 46%, rgba(217, 195, 163, 0.28), transparent 70%),
        linear-gradient(180deg, var(--brand-950) 0, var(--brand-900) 26%, #3a8fae 58%, var(--ivory) 86%);
    }

    .hero__bg {
      z-index: -1;
      overflow: hidden;
      margin: calc(var(--header-h) + 0.5rem) 1.9rem -4rem;
      border-radius: 999px 999px 0 0;
      box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
      /* Paralaks (main.ts) fotoğrafı çerçeve çizgisine göre kaydırıp aralığı bozar; mobilde kapalı */
      translate: none !important;
    }

    /* Fotoğrafın doğal yüksekliği kısa ekranlarda satırı büyütüp şeridi aşağı itmesin */
    .hero__bg :global(img) {
      position: absolute;
      inset: 0;
      object-position: 50% 42%;
    }

    /* Kemerin içinde sıcak ışık ve hafif koyu kenar: fotoğraf daha sinematik durur */
    .hero__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(70% 30% at 85% 14%, rgba(255, 224, 168, 0.34), transparent 72%),
        linear-gradient(180deg, rgba(5, 34, 50, 0.22), transparent 30%);
      pointer-events: none;
    }

    /* Kemeri saran ince şampanya çizgisi; aşağıda panelle birlikte kaybolur */
    .hero__shade::after {
      content: '';
      position: absolute;
      inset: calc(var(--header-h) + 0.5rem - 8px) calc(1.9rem - 8px) 2rem;
      border: 1px solid rgba(217, 195, 163, 0.75);
      border-radius: 999px 999px 0 0;
      pointer-events: none;
      -webkit-mask-image: linear-gradient(180deg, #000 0, #000 55%, transparent 88%);
      mask-image: linear-gradient(180deg, #000 0, #000 55%, transparent 88%);
    }

    /*
     * Kemerin iki yanındaki koyu zemin boş kalmasın diye ince şampanya çizgili diş, implant ve
     * diş fırçası motifleri, ışıltılar ve kenarlarda dikey marka yazısı. Fotoğrafın altında kalırlar
     * (.hero__bg z-index -1, bu katman da -1 ama DOM'da önce gelir).
     */
    .hero__deco {
      --top: var(--header-h);
      position: absolute;
      inset: 0;
      z-index: -1;
      display: block;
      overflow: hidden;
      pointer-events: none;
      color: var(--champagne-soft);
    }

    .deco {
      position: absolute;
      display: block;
    }

    .deco :global(.icon) {
      display: block;
      stroke-width: 1.1;
    }

    .deco--icon {
      opacity: 0.9;
      animation: deco-float 7s ease-in-out infinite alternate;
    }

    .deco--t1 {
      left: 0.8rem;
      top: calc(var(--top) + 4.7rem);
      rotate: -14deg;
    }

    .deco--t2 {
      right: 0.85rem;
      top: calc(var(--top) + 2.4rem);
      rotate: 12deg;
      animation-delay: -3s;
    }

    .deco--spark {
      opacity: 0.8;
      animation: deco-twinkle 3.6s ease-in-out infinite;
    }

    .deco--s1 {
      left: 3.5rem;
      top: calc(var(--top) + 2.7rem);
    }

    .deco--s2 {
      right: 0.9rem;
      top: calc(var(--top) + 6.3rem);
      animation-delay: -1.8s;
    }

    .deco--implant {
      left: 1rem;
      top: calc(var(--top) + 0.6rem);
      rotate: -12deg;
      animation-delay: -5s;
    }

    .deco--brush {
      right: 3.8rem;
      top: calc(var(--top) + 0.3rem);
      animation-delay: -1.5s;
    }

    /* Kenarlarda dikey marka yazısı; kemerin çizgisi ile ekran kenarı arasındaki dar şeride oturur */
    .deco--text {
      top: calc(var(--top) + 7rem);
      width: 0.9rem;
      writing-mode: vertical-rl;
      font-size: 0.5rem;
      font-weight: 700;
      letter-spacing: 0.34em;
      line-height: 0.9rem;
      white-space: nowrap;
      text-transform: uppercase;
      text-align: center;
      opacity: 0.78;
    }

    .deco--text-l {
      left: 0.3rem;
      rotate: 180deg;
    }

    .deco--text-r {
      right: 0.3rem;
    }

    @keyframes deco-float {
      to {
        translate: 0 -6px;
      }
    }

    @keyframes deco-twinkle {
      50% {
        opacity: 0.25;
        scale: 0.8;
      }
    }

    .hero__inner {
      grid-area: 2 / 1;
      z-index: 0;
      grid-template-columns: minmax(0, 1fr);
      /* Panelin üstüne taşan mührün alt yarısı için yer */
      padding-top: 2.75rem;
    }

    /*
     * Panel keskin bir kenarla değil, fotoğrafın içine eriyerek başlar: üstte şeffaf, aşağı doğru
     * buzlu cam ve fildişi. Bulanıklık da aynı maskeyle yavaşça belirir; çizgi ya da sert geçiş görünmez.
     */
    .hero__inner::before {
      content: '';
      position: absolute;
      inset: -5rem 0 0;
      z-index: -1;
      background:
        radial-gradient(70% 40% at 100% 38%, rgba(76, 195, 224, 0.14), transparent 70%),
        linear-gradient(
          180deg,
          rgba(250, 248, 244, 0) 0,
          rgba(250, 248, 244, 0.55) 3.2rem,
          rgba(250, 248, 244, 0.9) 5.8rem,
          var(--ivory) 8.5rem
        );
      backdrop-filter: blur(14px) saturate(130%);
      -webkit-backdrop-filter: blur(14px) saturate(130%);
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 4.5rem);
      mask-image: linear-gradient(180deg, transparent 0, #000 4.5rem);
    }

    /* `translate` giriş animasyonunun transform'uyla çakışmaz */
    .hero__seal {
      position: absolute;
      top: 0;
      right: var(--gutter);
      translate: 0 -50%;
      gap: 0.7rem;
      padding: 0.3rem 1.1rem 0.3rem 0.3rem;
      border-color: rgba(255, 255, 255, 0.7);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.5));
      box-shadow: 0 14px 30px -16px rgba(5, 34, 50, 0.55);
    }

    /* Mobilde dönen yazı yerine yalın logo: mühür tek bakışta okunsun */
    .seal {
      width: 44px;
      box-shadow: none;
    }

    .seal__ring {
      display: none;
    }

    .seal__core {
      width: 100%;
      background: var(--ivory);
      box-shadow: inset 0 0 0 1px rgba(184, 151, 107, 0.55);
    }

    .seal__core :global(img) {
      width: 24px;
    }

    .seal__stat {
      gap: 0.2rem;
      padding-left: 0.7rem;
      border-left-color: rgba(184, 151, 107, 0.55);
    }

    .seal__stat strong {
      font-size: 1.65rem;
      color: var(--brand-900);
    }

    .seal__stat strong span {
      color: var(--champagne);
    }

    .seal__label {
      font-size: 0.56rem;
      letter-spacing: 0.16em;
      color: var(--ink-mute);
    }

    .hero__copy {
      gap: var(--space-3);
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__copy > .eyebrow {
      color: var(--brand-700);
