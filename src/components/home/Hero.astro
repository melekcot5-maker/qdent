---
/**
 * Ana sayfa girişi: kliniğin girişi tam genişlik arka planda, üzerinde soldan sağa açılan lacivert
 * geçiş; menü bu sayfada en üstteyken beyaz görünür (index.astro → BaseLayout darkHero).
 * Mobilde fotoğraf üstte açık kalır, yazı onun üzerine binen lacivert panele geçer.
 */
import { Image } from 'astro:assets';
// Mankenli stok fotoğraf yerine kliniğin kendi girişi: yönetmelik yanıltıcı görsel kullanımını yasaklıyor
import entrance from '@/assets/images/clinic/entrance.jpg';
import mark from '@/assets/brand/logo-mark.png';
import Icon from '@/components/ui/Icon.astro';
import { site, links } from '@/config/site';
import { getTreatment, type TreatmentSlug } from '@/data/treatments';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const h = t.home.hero;

/**
 * Girişte ilk bakışta diş kliniği olduğu anlaşılsın diye öne çıkan tedaviler. Yalnızca hizmetin adı
 * (yönetmelik sunulan hizmetlerin bilgisine izin verir); fiyat veya sonuç iddiası eklenmemeli.
 */
const featured: TreatmentSlug[] = ['dental-implants', 'smile-design', 'zirconia-crowns', 'root-canal-treatment'];
const chips = featured.flatMap((slug) => getTreatment(slug) ?? []);
---

<section class="hero">
  <!-- Paralaks kaydırırken kenar boşluğu görünmesin diye arka plan bölümden biraz taşar -->
  <div class="hero__bg" data-parallax="0.1" aria-hidden="true">
    <Image src={entrance} alt="" widths={[768, 1280, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- Marka adı İngilizce işaretlenir; aksi halde Türkçe büyük harf dönüşümü "QUALİTY" yazar -->
      <p class="eyebrow" data-hero style="--h: 0"><span><span class="hero__brand" lang="en">Quality Dental Center · </span>{h.eyebrow}</span></p>

      <h1 class="hero__title">
        <span class="hero__line"><span data-hero-line style="--h: 1">{h.titleTop}</span></span>
        <span class="hero__line">
          <span data-hero-line style="--h: 2"><em>{h.titleAccent}</em> {h.titleBottom}</span>
        </span>
      </h1>

      <p class="lead hero__lead" data-hero style="--h: 4">{h.lead}</p>

      <!-- Bu butonlar görünürken mobildeki sabit Ara/WhatsApp butonları gizlenir (main.ts → initFloatHide) -->
      <div class="hero__actions" data-hero data-float-hide style="--h: 5">
        <a href={links.whatsapp(t.common.whatsappMessage)} class="btn btn--primary" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          {h.primaryCta}
        </a>
        <a href={localizePath(lang, 'treatments')} class="btn btn--outline-light">
          {h.secondaryCta}
          <Icon name="arrowRight" size={16} class="icon--arrow" />
        </a>
      </div>

      <nav class="hero__treatments" data-hero style="--h: 6" aria-label={t.home.treatments.eyebrow}>
        <ul role="list">
          {
            chips.map((tr) => (
              <li>
                <a href={localizePath(lang, `treatments/${tr.slug}`)}>
                  <span class="hero__chip-icon" aria-hidden="true">
                    <Icon name={tr.icon} size={16} />
                  </span>
                  {t.treatments.items[tr.slug].name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Sağ altta mühür: dönen marka yazısı içinde Q logosu, yanında deneyim yılı -->
    <div class="hero__seal" data-hero style="--h: 7">
      <div class="seal" aria-hidden="true">
        <svg class="seal__ring" viewBox="0 0 200 200">
          <defs>
            <path id="hero-seal-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
          </defs>
          <!-- textLength çemberin çevresine (2π·78 ≈ 490) eşit: yazı boşluksuz ve eşit aralıkla tam tur atar -->
          <text><textPath href="#hero-seal-path" textLength="488" lengthAdjust="spacing">QUALITY DENTAL CENTER · ÖLÜDENİZ · FETHİYE ·</textPath></text>
        </svg>
        <span class="seal__core">
          <Image src={mark} alt="" width={40} densities={[1, 2]} />
        </span>
      </div>
      <div class="seal__stat">
        <strong>{site.experienceYears}<span>+</span></strong>
        <span class="seal__label">{h.experienceBadge}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(100svh, 980px);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 6rem;
    background: var(--brand-950);
    color: var(--on-dark);
  }

  .hero__bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }

  /*
   * Örnek tasarımdaki gibi lacivert ton: yazının altı koyu, sağa doğru açılır.
   * Üstteki ek koyuluk beyaz menünün okunmasını sağlar.
   */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(5, 34, 50, 0.55) 0%, rgba(5, 34, 50, 0) 26%),
      radial-gradient(60% 70% at 0% 100%, rgba(76, 195, 224, 0.18), transparent 70%),
      linear-gradient(90deg, rgba(5, 34, 50, 0.93) 0%, rgba(5, 34, 50, 0.8) 38%, rgba(8, 51, 74, 0.5) 68%, rgba(8, 51, 74, 0.3) 100%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-6);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 820px;
  }

  .hero__copy > .eyebrow {
    color: var(--champagne-soft);
  }

  .hero__title {
    font-size: clamp(2.3rem, 1.2rem + 4.4vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__title em {
    font-weight: 500;
    background: linear-gradient(100deg, #8fdcf0, #bfe9f4 45%, var(--champagne-soft));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
  }

  .hero__lead {
    max-width: 52ch;
    color: rgba(244, 248, 251, 0.86);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-2);
  }

  /* ---------- Öne çıkan tedaviler: ikonlu buzlu cam çipler ---------- */
  .hero__treatments ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: var(--space-2) 0 0;
  }

  .hero__treatments a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .hero__treatments a:hover {
    border-color: rgba(217, 195, 163, 0.7);
    background: rgba(255, 255, 255, 0.16);
  }

  .hero__chip-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(217, 195, 163, 0.18);
    color: var(--champagne-soft);
  }

  /* ---------- Sağ altta mühür ---------- */
  .hero__seal {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 0.85rem 2rem 0.85rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    /* Lacivert tonlu cam: arkası açık duvar da olsa yazılar aynı netlikte okunur */
    background: linear-gradient(135deg, rgba(8, 51, 74, 0.62), rgba(5, 34, 50, 0.42));
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.55);
  }

  .seal {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 112px;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(217, 195, 163, 0.45);
  }

  .seal__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: seal-spin 40s linear infinite;
  }

  .seal__ring text {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    fill: var(--champagne-soft);
  }

  /* Ortadaki fildişi daire: logo laciverdin üzerinde değil, açık zeminde net görünür */
  .seal__core {
    display: grid;
    place-items: center;
    width: 58px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #fff, var(--ivory) 70%);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.12),
      0 0 0 4px rgba(217, 195, 163, 0.7),
      0 10px 24px -8px rgba(0, 0, 0, 0.5);
  }

  .seal__core :global(img) {
    width: 30px;
    height: auto;
  }

  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .seal__stat {
    display: grid;
    gap: 0.35rem;
    padding-left: 1.4rem;
    border-left: 1px solid rgba(217, 195, 163, 0.45);
  }

  .seal__stat strong {
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 500;
    font-variant-numeric: lining-nums;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .seal__stat strong span {
    margin-left: 0.04em;
    font-style: italic;
    color: var(--champagne-soft);
  }

  .seal__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }

  /* ---------- Giriş animasyonu (perde kalktıktan sonra) ---------- */
  :global(html.js) .hero__bg :global(img) {
    animation: hero-zoom 2.6s var(--ease-out) both;
    animation-delay: var(--intro-delay);
  }

  :global(html.js) [data-hero] {
    animation: hero-rise 1.3s var(--ease-out) both;
    animation-delay: calc(var(--intro-delay) + var(--h) * 110ms);
  }

  :global(html.js) [data-hero-line] {
    animation: hero-line 1.4s var(--ease-out) both;
    animation-delay: calc(var(--intro-delay) + var(--h) * 120ms);
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.1);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__bg :global(img),
    :global(html.js) [data-hero],
    :global(html.js) [data-hero-line],
    .seal__ring {
      animation: none;
    }
  }

  /* ---------- Duyarlı ---------- */
  /*
   * Dar ekranda yazı fotoğrafın tamamını kaplıyor, giriş koyu tonun altında kayboluyordu.
   * Burada fotoğraf üstte açık kalır, yazı ona binen yuvarlak köşeli lacivert panele geçer,
   * mühür de fotoğrafla panelin sınırına oturur.
   *
   * Giriş, altındaki tedavi şeridi (Marquee) ilk ekranda görünecek kadar kısa tutulur: panel
   * içeriği kadar yer kaplar, kalan yüksekliği fotoğraf doldurur. Şeridin yüksekliği değişirse
   * --marquee-h de güncellenmeli.
   */
  @media (max-width: 860px) {
    .hero {
      --marquee-h: 5.75rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(10rem, 1fr) auto;
      align-items: stretch;
      min-height: calc(100svh - var(--marquee-h));
      padding: 0 0 var(--space-6);
    }

    /* Fotoğraf ilk satırı doldurur ve panelin yuvarlak köşelerinin altına uzanır;
       paralaks onu aşağı ittiğinde üstte boşluk kalmasın diye biraz yukarıdan başlar */
    .hero__bg,
    .hero__shade {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
      margin-bottom: calc(-1 * var(--radius-xl));
    }

    .hero__bg {
      margin-top: -48px;
    }

    /* Fotoğrafın doğal yüksekliği kısa ekranlarda satırı büyütüp şeridi aşağı itmesin */
    .hero__bg :global(img) {
      position: absolute;
      inset: 0;
    }

    /* Yalnızca üstte menü için koyuluk; çiçekler ve kapı kendi renginde görünür */
    .hero__shade {
      background: linear-gradient(
        180deg,
        rgba(5, 34, 50, 0.72) 0,
        rgba(5, 34, 50, 0.18) calc(var(--header-h) + 3rem),
        rgba(5, 34, 50, 0.05) calc(var(--header-h) + 6rem),
        rgba(5, 34, 50, 0.4) 100%
      );
    }

    .hero__inner {
      grid-area: 2 / 1;
      z-index: 0;
      grid-template-columns: minmax(0, 1fr);
      /* Panelin üstüne taşan mührün alt yarısı için yer */
      padding-top: 3.5rem;
    }

    .hero__inner::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      background:
        radial-gradient(90% 50% at 0% 0%, rgba(76, 195, 224, 0.14), transparent 70%),
        var(--brand-950);
      box-shadow:
        inset 0 1px 0 rgba(217, 195, 163, 0.35),
        0 -24px 48px -24px rgba(0, 0, 0, 0.45);
    }

    /* `translate` giriş animasyonunun transform'uyla çakışmaz */
    .hero__seal {
      position: absolute;
      top: 0;
      right: var(--gutter);
      translate: 0 -50%;
      gap: 0.8rem;
      padding: 0.4rem 1.15rem 0.4rem 0.4rem;
    }

    .seal {
      width: 76px;
    }

    .seal__ring text {
      font-size: 15px;
    }

    .seal__core {
      width: 40px;
    }

    .seal__core :global(img) {
      width: 21px;
    }

    .seal__stat {
      gap: 0.25rem;
      padding-left: 0.8rem;
    }

    .seal__stat strong {
      font-size: 2.2rem;
    }

    .seal__label {
      font-size: 0.6rem;
      letter-spacing: 0.18em;
    }

    .hero__copy {
      gap: var(--space-3);
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__lead {
      font-size: var(--text-sm);
      line-height: 1.65;
    }

    /* Aynı tedavi adları hemen alttaki şeritte kayıyor; ilk ekranda iki kez görünmesin */
    .hero__treatments {
      display: none;
    }
  }

  @media (max-width: 480px) {
    /* Marka adı menüdeki logoda ve mühürde zaten var; satır ikiye bölünmesin */
    .hero__brand {
      display: none;
    }

    .hero__actions {
      display: grid;
      gap: 0.6rem;
      width: 100%;
    }

    .hero__actions .btn {
      min-height: 48px;
    }
  }
</style>
