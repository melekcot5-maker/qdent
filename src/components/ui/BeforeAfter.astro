---
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  /** Kaydırıcı için ekran okuyucu etiketi */
  label: string;
  alt: string;
}

const { before, after, beforeLabel, afterLabel, label, alt } = Astro.props;
---

<div class="ba" data-ba style="--pos: 50%">
  <Image src={before} alt={`${alt} — ${beforeLabel}`} class="ba__img" widths={[480, 720, 960]} sizes="(max-width: 860px) 92vw, 46vw" />
  <Image src={after} alt={`${alt} — ${afterLabel}`} class="ba__img ba__img--after" widths={[480, 720, 960]} sizes="(max-width: 860px) 92vw, 46vw" />

  <span class="ba__tag ba__tag--before">{beforeLabel}</span>
  <span class="ba__tag ba__tag--after">{afterLabel}</span>

  <span class="ba__handle" aria-hidden="true">
    <i>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path></svg>
    </i>
  </span>

  <input class="ba__range" type="range" min="0" max="100" step="0.1" value="50" aria-label={label} />
</div>

<style>
  .ba {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    background: var(--sand-100);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .ba :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Sonrası, kaydırıcı konumundan sağa doğru görünür */
  .ba :global(.ba__img--after) {
    clip-path: inset(0 0 0 var(--pos));
  }

  .ba__tag {
    position: absolute;
    top: 0.9rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .ba__tag--before {
    left: 0.9rem;
  }

  .ba__tag--after {
    right: 0.9rem;
    background: var(--brand-600);
    color: #fff;
  }

  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  .ba__handle i {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pearl);
    color: var(--brand-600);
    box-shadow:
      var(--shadow-md),
      0 0 0 1px rgba(184, 151, 107, 0.5);
    translate: -50% -50%;
    transition: scale var(--dur) var(--ease-out);
  }

  .ba:hover .ba__handle i,
  .ba:focus-within .ba__handle i {
    scale: 1.08;
  }

  /* Görünmez, tüm alanı kaplayan aralık girdisi: dokunma, sürükleme ve klavye desteği */
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba:focus-within {
    outline: 2px solid var(--brand-500);
    outline-offset: 3px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba__range');
    range?.addEventListener('input', () => el.style.setProperty('--pos', `${range.value}%`));
  });
</script>
