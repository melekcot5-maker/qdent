---
import { icons, filledIcons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** Ekran okuyucu için anlam taşıyorsa doldurun; boşsa ikon dekoratif sayılır. */
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const filled = filledIcons.has(name);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={icons[name]}
/>
