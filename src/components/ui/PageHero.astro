---
/**
 * İç sayfaların başlık alanı: içerik haritası (breadcrumb), üst başlık, başlık ve giriş.
 * Breadcrumb aynı zamanda schema.org BreadcrumbList olarak işaretlenir.
 *
 * `image` verilirse fotoğraf tam genişlikte arka plana yerleşir ve üzerine soldan sağa açılan
 * lacivert bir geçiş gelir. Bu durumda sayfa BaseLayout'a `darkHero` vermeli ki menü beyaz görünsün.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  /** Fotoğrafın kadrajı (CSS object-position); ilgi çekici kısım geçişin açık tarafında, sağda kalmalı */
  imagePosition?: string;
}

const { eyebrow, title, lead, crumbs, image, imagePosition = '50% 50%' } = Astro.props;
const base = Astro.site ?? new URL(site.url);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, base).href } : {}),
  })),
};
---

<section class:list={['page-hero', image && 'page-hero--photo']}>
  {
    image ? (
      <>
        <div class="page-hero__bg" data-parallax="0.08" aria-hidden="true">
          <Image
            src={image}
            alt=""
            widths={[768, 1280, 1600, 2048]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            style={`object-position: ${imagePosition}`}
          />
        </div>
        <div class="page-hero__shade" aria-hidden="true" />
      </>
    ) : (
      <div class="page-hero__light" aria-hidden="true" />
    )
  }
  <div class="container page-hero__inner">
    <nav class="crumbs" aria-label="Breadcrumb" data-reveal="fade">
      <ol role="list">
        {
          crumbs.map((c, i) => (
            <li>
              {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="eyebrow" data-reveal style="--d: 1">{eyebrow}</p>
    <h1 class="page-hero__title" data-reveal style="--d: 2">{title}</h1>
    {lead && <p class="lead page-hero__lead" data-reveal style="--d: 3">{lead}</p>}
    <slot />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 5vw, 7rem));
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .page-hero__light {
    position: absolute;
    inset: -30% -20% auto auto;
    width: min(80vw, 900px);
    aspect-ratio: 1;
    background:
      radial-gradient(closest-side, rgba(76, 195, 224, 0.16), transparent 70%),
      radial-gradient(closest-side at 30% 70%, rgba(217, 195, 163, 0.25), transparent 70%);
    filter: blur(10px);
    pointer-events: none;
    animation: page-light 18s var(--ease-in-out) infinite alternate;
  }

  @keyframes page-light {
    to {
      transform: translate3d(-6%, 8%, 0) scale(1.08);
    }
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .page-hero__title {
    max-width: 16ch;
    font-size: var(--text-4xl);
  }

  .page-hero__lead {
    max-width: 60ch;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    color: var(--line-strong);
  }

  .crumbs a {
    transition: color var(--dur-fast);
  }

  .crumbs a:hover {
    color: var(--brand-700);
  }

  /* ---------- Tam genişlik fotoğraflı başlık ---------- */
  .page-hero--photo {
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(440px, 22rem + 16vw, 640px);
    background: var(--brand-950);
  }

  /* Paralaks kaydırırken kenar boşluğu görünmesin diye arka plan bölümden biraz taşar */
  .page-hero__bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
  }

  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: page-hero-zoom 2.4s var(--ease-out) both;
  }

  /* Üstte menünün okunması için ek koyuluk; soldan sağa yazının altı koyu, fotoğraf sağda açık */
  .page-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(5, 34, 50, 0.55) 0%, rgba(5, 34, 50, 0) 30%),
      radial-gradient(55% 90% at 0% 100%, rgba(76, 195, 224, 0.18), transparent 70%),
      linear-gradient(90deg, rgba(5, 34, 50, 0.93) 0%, rgba(5, 34, 50, 0.8) 36%, rgba(8, 51, 74, 0.48) 66%, rgba(8, 51, 74, 0.25) 100%);
  }

  @keyframes page-hero-zoom {
    from {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__bg :global(img) {
      animation: none;
    }
  }

  .page-hero--photo .page-hero__title {
    max-width: 18ch;
    color: #fff;
  }

  .page-hero--photo .page-hero__lead {
    max-width: 52ch;
    color: rgba(244, 248, 251, 0.86);
  }

  .page-hero--photo .eyebrow {
    color: var(--champagne-soft);
  }

  .page-hero--photo .crumbs ol {
    color: var(--on-dark-soft);
  }

  .page-hero--photo .crumbs li + li::before {
    color: rgba(255, 255, 255, 0.35);
  }

  .page-hero--photo .crumbs a:hover {
    color: #fff;
  }

  /* Dar ekranda yazı tüm genişliği kapladığı için ton yukarıdan aşağıya koyulaşır */
  @media (max-width: 720px) {
    .page-hero__shade {
      background: linear-gradient(180deg, rgba(5, 34, 50, 0.7) 0%, rgba(5, 34, 50, 0.78) 40%, rgba(5, 34, 50, 0.93) 100%);
    }
  }
</style>
