---
import Icon from './Icon.astro';
import type { TreatmentMeta } from '@/data/treatments';
import { getDictionary, localizePath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  treatment: TreatmentMeta;
  index: number;
}

const { lang, treatment, index } = Astro.props;
const t = getDictionary(lang);
const content = t.treatments.items[treatment.slug];
---

<a href={localizePath(lang, `treatments/${treatment.slug}`)} class="tcard card glow" data-reveal style={`--d: ${index % 4}`}>
  <span class="tcard__accent" aria-hidden="true"></span>
  <span class="tcard__top">
    <span class="tcard__icon"><Icon name={treatment.icon} size={24} /></span>
    <span class="tcard__num">{String(index + 1).padStart(2, '0')}</span>
  </span>
  <h3 class="tcard__name">{content.name}</h3>
  <p class="tcard__short">{content.short}</p>
  <span class="tcard__more">
    {t.common.learnMore}
    <Icon name="arrowRight" size={16} />
  </span>
</a>

<style>
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    height: 100%;
    padding: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    overflow: hidden;
    border-radius: var(--radius-md);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .tcard__accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-600), var(--champagne) 85%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .tcard:hover .tcard__accent {
    transform: scaleX(1);
  }

  .tcard:hover {
    transform: translateY(-4px);
    border-color: var(--brand-200);
    box-shadow: var(--shadow-md);
  }

  .tcard__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.1rem;
  }

  .tcard__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--brand-50), #fff);
    border: 1px solid var(--brand-100);
    color: var(--brand-600);
    transition:
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .tcard:hover .tcard__icon {
    background: var(--brand-600);
    color: #fff;
    box-shadow: var(--glow-brand);
    transform: rotate(-8deg) scale(1.06);
  }

  .tcard__num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--champagne);
  }

  .tcard__name {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .tcard__short {
    flex: 1;
    font-size: var(--text-sm);
    line-height: 1.6;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .tcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-700);
  }

  .tcard__more :global(.icon) {
    transition: transform var(--dur) var(--ease-out);
  }

  .tcard:hover .tcard__more :global(.icon) {
    transform: translateX(4px);
  }
</style>
