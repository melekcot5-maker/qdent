---
/**
 * Yalnızca doğrulanabilir, olgusal sayılar. Google puanı ve "ücretsiz muayene" gibi ifadeler
 * yönetmelik gereği (memnuniyet ve ücret/promosyon bilgisi yasağı) burada yer almaz.
 */
import { site } from '@/config/site';
import { treatments } from '@/data/treatments';
import { locales, getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);

const stats = [
  { value: `${site.experienceYears}+`, label: t.home.stats.experience },
  { value: String(site.team.filter((m) => m.role === 'dentist').length), label: t.home.stats.dentists },
  { value: String(locales.length), label: t.home.stats.languages },
  { value: String(treatments.length), label: t.home.stats.treatments },
];
---

<div class="stats">
  <dl class="stats__grid">
    {
      stats.map((s, i) => (
        <div class="stats__item" data-reveal style={`--d: ${i}`}>
          <dt class="stats__label">{s.label}</dt>
          <dd class="stats__value">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .stats {
    border-top: 1px solid var(--line);
  }

  /* Kolonun genişliğine göre 2 ya da 4 sütun; dar kolonda uzun etiketler 4 sütuna sığmıyor */
  .stats__grid {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    min-width: 0;
    padding: 1.5rem 1.25rem 0 0;
  }

  .stats__item:nth-child(even) {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .stats__value {
    font-family: var(--font-sans);
    font-size: clamp(1.4rem, 7cqw, var(--text-2xl));
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1;
    overflow-wrap: anywhere;
    color: var(--brand-700);
  }

  .stats__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  @container (min-width: 52rem) {
    .stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stats__item:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .stats__item + .stats__item {
      padding-left: 1.25rem;
      border-left: 1px solid var(--line);
    }
  }
</style>
