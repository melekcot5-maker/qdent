---
/**
 * Çalışma saatleri tablosu. Gün adları tarayıcı/dil API'sinden gelir (çeviri gerekmez).
 * Bugünün satırı istemci tarafında, otel saat dilimine göre vurgulanır (main.ts).
 */
import { site } from '@/config/site';
import { getDictionary, localeMeta, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  tone?: 'light' | 'dark';
}

const { lang, tone = 'light' } = Astro.props;
const t = getDictionary(lang);
const fmt = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { weekday: 'long', timeZone: 'UTC' });
// 2024-01-01 bir Pazartesi; ISO gün numarasına göre ad üretmek için referans
const dayName = (isoDay: number) => fmt.format(new Date(Date.UTC(2024, 0, isoDay)));
---

<dl class:list={['hours', `hours--${tone}`]} data-hours data-tz={site.timeZone}>
  {
    site.hours.map((h) => (
      <div class="hours__row" data-day={h.day}>
        <dt>
          {dayName(h.day)}
          <span class="hours__today">{t.common.today}</span>
        </dt>
        <dd>{h.open && h.close ? `${h.open} – ${h.close}` : t.common.closed}</dd>
      </div>
    ))
  }
</dl>

<style>
  .hours {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    font-size: var(--text-sm);
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--line);
  }

  .hours--dark .hours__row {
    border-color: var(--line-on-dark);
  }

  .hours dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: capitalize;
  }

  .hours dd {
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .hours--dark dd {
    color: var(--on-dark-soft);
  }

  .hours__today {
    display: none;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--brand-600);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hours__row.is-today dt {
    font-weight: 600;
  }

  .hours__row.is-today .hours__today {
    display: inline-block;
  }
</style>
