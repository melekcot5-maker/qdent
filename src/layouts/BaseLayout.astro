---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource-variable/manrope';
import '@/styles/global.css';

import Seo from '@/components/layout/Seo.astro';
import IntroLoader from '@/components/layout/IntroLoader.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FloatingActions from '@/components/layout/FloatingActions.astro';
import CookieConsent from '@/components/layout/CookieConsent.astro';
import { getDictionary, localeMeta, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Dil öneki olmadan sayfa yolu; ana sayfa için boş */
  path?: string;
  image?: string;
  noindex?: boolean;
  /** Sayfa koyu, tam genişlik fotoğraflı bir başlıkla açılıyor: üst menü en üstte beyaz görünür */
  darkHero?: boolean;
}

const { lang, title, description, path = '', image, noindex, darkHero = false } = Astro.props;
const t = getDictionary(lang);
---

<!doctype html>
<html lang={localeMeta[lang].htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf8f4" />
    <meta name="format-detection" content="telephone=no" />

    <!-- JS var mı, açılış perdesi oynasın mı: ilk boyamadan önce karar verilir -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && !sessionStorage.getItem('qd-intro')) {
            root.classList.add('intro-play');
            sessionStorage.setItem('qd-intro', '1');
          }
        } catch (e) {}
      })();
    </script>

    <Seo lang={lang} title={title} description={description} path={path} image={image} noindex={noindex} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a href="#main" class="skip-link">{t.nav.skipToContent}</a>
    <IntroLoader />
    <Header lang={lang} path={path} onDark={darkHero} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} path={path} />
    <FloatingActions lang={lang} />
    <CookieConsent lang={lang} />

    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
