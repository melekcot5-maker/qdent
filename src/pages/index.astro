---
/**
 * Kök adres (/) — ziyaretçiyi diline yönlendirir:
 *   1) daha önce seçtiği dil (localStorage "qd-lang"),
 *   2) tarayıcı dili,
 *   3) varsayılan dil.
 * JavaScript kapalıysa <noscript> içindeki yönlendirme ve dil bağlantıları devreye girer.
 */
import { site } from '@/config/site';
import { defaultLocale, locales, localeMeta, localizePath } from '@/i18n';

const base = Astro.site ?? new URL(site.url);
const config = JSON.stringify({ locales, fallback: defaultLocale });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.legalName}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={new URL(localizePath(l), base).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', base).href} />
    <script is:inline define:vars={{ config }}>
      (function () {
        var cfg = JSON.parse(config);
        var pick = null;
        try {
          var saved = localStorage.getItem('qd-lang');
          if (cfg.locales.indexOf(saved) !== -1) pick = saved;
        } catch (e) {}
        if (!pick) {
          var prefs = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < prefs.length && !pick; i++) {
            var code = String(prefs[i]).slice(0, 2).toLowerCase();
            if (cfg.locales.indexOf(code) !== -1) pick = code;
          }
        }
        window.location.replace('/' + (pick || cfg.fallback) + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${localizePath(defaultLocale)}`} /></noscript>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #faf8f4;
        font-family: system-ui, sans-serif;
        color: #0f2230;
      }
      nav {
        display: flex;
        gap: 0.75rem;
      }
      a {
        color: #1074a2;
      }
    </style>
  </head>
  <body>
    <nav aria-label="Language">
      {locales.map((l) => <a href={localizePath(l)}>{localeMeta[l].nativeName}</a>)}
    </nav>
  </body>
</html>
