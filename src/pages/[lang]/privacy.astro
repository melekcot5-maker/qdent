---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getDictionary, localeMeta, localeStaticPaths, localizePath, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const p = t.privacy;

/** Metin her güncellendiğinde bu tarih de güncellenmeli. */
const updatedAt = new Date('2026-10-23');
const updated = new Intl.DateTimeFormat(localeMeta[lang].htmlLang, { dateStyle: 'long' }).format(updatedAt);
---

<BaseLayout lang={lang} title={p.meta.title} description={p.meta.description} path="privacy">
  <PageHero
    eyebrow={t.footer.privacy}
    title={p.title}
    lead={`${p.updated}: ${updated}`}
    crumbs={[{ label: t.common.breadcrumbHome, href: localizePath(lang) }, { label: p.title }]}
  />

  <section class="section section--pearl">
    <div class="container container--narrow prose">
      <p class="draft">{p.draftNotice}</p>
      {
        p.sections.map((s, i) => (
          <section data-reveal style={`--d: ${i % 3}`}>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    display: grid;
    gap: 2.5rem;
  }

  .prose h2 {
    margin-bottom: 0.75rem;
    font-size: var(--text-2xl);
  }

  .prose p {
    color: var(--ink-soft);
  }

  .draft {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--champagne);
    border-radius: var(--radius-sm);
    background: var(--sand-100);
    font-size: var(--text-sm);
  }
</style>
