---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import TreatmentCard from '@/components/ui/TreatmentCard.astro';
import Journey from '@/components/home/Journey.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { treatments } from '@/data/treatments';
import { getDictionary, localeStaticPaths, localizePath, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const p = t.treatments;
---

<BaseLayout lang={lang} title={p.meta.title} description={p.meta.description} path="treatments">
  <PageHero
    eyebrow={p.hero.eyebrow}
    title={p.hero.title}
    lead={p.hero.lead}
    crumbs={[{ label: t.common.breadcrumbHome, href: localizePath(lang) }, { label: t.nav.treatments }]}
  />

  <section class="section section--pearl">
    <div class="container">
      <ul class="grid" role="list">
        {
          treatments.map((tr, i) => (
            <li>
              <TreatmentCard lang={lang} treatment={tr} index={i} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Journey lang={lang} />
  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
