---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Marquee from '@/components/home/Marquee.astro';
import IntroAbout from '@/components/home/IntroAbout.astro';
import TreatmentsSection from '@/components/home/TreatmentsSection.astro';
import WhyUs from '@/components/home/WhyUs.astro';
import Journey from '@/components/home/Journey.astro';
import Location from '@/components/home/Location.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { getDictionary, localeStaticPaths, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} title={t.home.meta.title} description={t.home.meta.description} darkHero>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <IntroAbout lang={lang} />
  <TreatmentsSection lang={lang} />
  <WhyUs lang={lang} />
  <Journey lang={lang} />
  <Location lang={lang} />
  <CtaBand lang={lang} />
</BaseLayout>
