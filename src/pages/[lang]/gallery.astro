---
import { Image } from 'astro:assets';
import facade from '@/assets/images/clinic/facade.jpg';
import reception from '@/assets/images/clinic/reception.jpg';
import lounge from '@/assets/images/clinic/lounge.jpg';
import treatmentRoom from '@/assets/images/clinic/treatment-room.jpg';
import treatmentRoom2 from '@/assets/images/clinic/treatment-room-2.jpg';
import digitalScan from '@/assets/images/clinic/digital-scan.jpg';
import xrayRoom from '@/assets/images/clinic/xray-room.jpg';
import refreshments from '@/assets/images/clinic/refreshments.jpg';
import entrance from '@/assets/images/clinic/entrance.jpg';
import bondingBefore from '@/assets/images/results/bonding-before.jpg';
import bondingAfter from '@/assets/images/results/bonding-after.jpg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import BeforeAfter from '@/components/ui/BeforeAfter.astro';
import BeforeAfterSoon from '@/components/ui/BeforeAfterSoon.astro';
import type { IconName } from '@/components/ui/icons';
import { treatments, type BeforeAfterCase } from '@/data/treatments';
import { getDictionary, localeStaticPaths, localizePath, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const g = t.gallery;

/**
 * Mozaik sırası 3 sütunda boşluksuz dolacak şekilde dizildi (tall = 2 satır, wide = 2 sütun);
 * dar ekranlarda kalan boşlukları `grid-auto-flow: dense` kapatır.
 */
const photos = [
  { src: facade, caption: g.captions.facade, size: 'tall' },
  { src: reception, caption: g.captions.reception, size: 'wide' },
  { src: lounge, caption: g.captions.lounge, size: 'square' },
  { src: treatmentRoom, caption: g.captions.treatmentRoom, size: 'square' },
  { src: treatmentRoom2, caption: g.captions.treatmentRoom, size: 'wide' },
  { src: digitalScan, caption: g.captions.digitalScan, size: 'square' },
  { src: xrayRoom, caption: g.captions.xray, size: 'square' },
  { src: refreshments, caption: g.captions.refreshments, size: 'square' },
  { src: entrance, caption: g.captions.entrance, size: 'square' },
] as const;

/** Sitede ayrı tedavi sayfası olmayan vakalar; adları sözlükte `gallery.extraCases` altında */
const extraCases: { key: keyof typeof g.extraCases; icon: IconName; example: BeforeAfterCase }[] = [
  { key: 'bonding', icon: 'smile', example: { before: bondingBefore, after: bondingAfter, kind: 'clinic' } },
];

/**
 * Her tedavi için bir kart (vakalar src/data/treatments.ts içinde). Önce/sonra görseli olanlar kaydırmalı
 * karşılaştırma gösterir, diğerleri "yakında" yer tutucusu. Sıralama: önce kliniğin gerçek sonuçları
 * ("Klinik sonucu"), ardından temsili örnekler, en sonda görseli henüz olmayanlar.
 */
const rank = (example?: BeforeAfterCase) => (example ? (example.kind === 'clinic' ? 0 : 1) : 2);
const results = [
  ...treatments.map((tr) => ({ icon: tr.icon, name: t.treatments.items[tr.slug].name, example: tr.result })),
  ...extraCases.map((c) => ({ icon: c.icon, name: g.extraCases[c.key], example: c.example })),
].sort((a, b) => rank(a.example) - rank(b.example));
---

<BaseLayout lang={lang} title={g.meta.title} description={g.meta.description} path="gallery">
  <PageHero
    eyebrow={g.hero.eyebrow}
    title={g.hero.title}
    lead={g.hero.lead}
    crumbs={[{ label: t.common.breadcrumbHome, href: localizePath(lang) }, { label: t.nav.gallery }]}
  />

  <section class="section section--pearl">
    <div class="container">
      <header class="section-head">
        <h2 data-reveal>{g.clinicTitle}</h2>
      </header>
      <ul class="mosaic" role="list">
        {
          photos.map((p, i) => (
            <li class:list={['mosaic__item', `mosaic__item--${p.size}`]} data-reveal="curtain" style={`--d: ${i}`}>
              <Image src={p.src} alt={p.caption} widths={[480, 720, 1080, 1440]} sizes="(max-width: 860px) 92vw, 50vw" />
              <span class="mosaic__caption">{p.caption}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head">
        <h2 data-reveal>{g.resultsTitle}</h2>
        <p class="muted" data-reveal style="--d: 1">{g.resultsLead}</p>
      </header>
      <ul class="results" role="list">
        {
          results.map((r, i) => (
            <li class="results__item" data-reveal style={`--d: ${i % 3}`}>
              {r.example ? (
                <BeforeAfter
                  before={r.example.before}
                  after={r.example.after}
                  beforeLabel={g.before}
                  afterLabel={g.after}
                  label={g.sliderLabel}
                  alt={r.name}
                />
              ) : (
                <BeforeAfterSoon icon={r.icon} beforeLabel={g.before} afterLabel={g.after} />
              )}
              <div class="results__meta">
                <span>{r.name}</span>
                <span class:list={[r.example ? 'results__sample' : 'results__soon', r.example?.kind === 'clinic' && 'results__sample--clinic']}>
                  {r.example ? (r.example.kind === 'clinic' ? g.clinicCase : g.sample) : g.soon}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(180px, 14vw + 60px, 300px);
    grid-auto-flow: dense;
    gap: 1.25rem;
    margin: 0;
  }

  .mosaic__item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .mosaic__item--tall {
    grid-row: span 2;
  }

  .mosaic__item--wide {
    grid-column: span 2;
  }

  .mosaic__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .mosaic__item:hover :global(img) {
    transform: scale(1.04);
  }

  .mosaic__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) clamp(1.25rem, 1rem + 1vw, 1.75rem);
    margin: 0;
  }

  .results__soon {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-mute);
  }

  .results__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem 0;
    font-weight: 600;
    font-size: var(--text-base);
  }

  .results__sample {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--sand-100);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-mute);
  }

  .results__sample--clinic {
    background: var(--brand-50);
    color: var(--brand-600);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
    }

    .mosaic__item--tall {
      grid-row: span 1;
    }

  }

  @media (max-width: 1000px) {
    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .results {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .mosaic {
      grid-template-columns: 1fr;
    }

    .mosaic__item--wide {
      grid-column: span 1;
    }
  }
</style>
