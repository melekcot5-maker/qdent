---
import { Image } from 'astro:assets';
import room from '@/assets/images/clinic-room.jpg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Stats from '@/components/ui/Stats.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { site } from '@/config/site';
import { getDictionary, localeStaticPaths, localizePath, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const a = t.about;
const valueIcons: IconName[] = ['document', 'leaf', 'infinity', 'sparkles', 'shield', 'clock'];

/** "Dt. Dilara Nur Kılınç" → "DK" */
const initials = (name: string) =>
  name
    .replace(/^Dt\.\s*/, '')
    .split(/\s+/)
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .map((w) => w[0])
    .join('');

const dentists = site.team.filter((m) => m.role === 'dentist');
const crew = site.team.filter((m) => m.role !== 'dentist');
---

<BaseLayout lang={lang} title={a.meta.title} description={a.meta.description} path="about">
  <PageHero
    eyebrow={a.hero.eyebrow}
    title={a.hero.title}
    lead={a.hero.lead}
    crumbs={[{ label: t.common.breadcrumbHome, href: localizePath(lang) }, { label: t.nav.about }]}
  />

  <section class="section section--pearl">
    <div class="container story">
      <figure class="story__photo" data-reveal="curtain">
        <Image src={room} alt={t.gallery.captions.room} widths={[480, 720, 960, 1200]} sizes="(max-width: 860px) 92vw, 48vw" />
      </figure>
      <div class="story__copy">
        <p class="eyebrow" data-reveal>{a.story.eyebrow}</p>
        <h2 data-reveal style="--d: 1">{a.story.title}</h2>
        {
          a.story.body.map((p, i) => (
            <p class="muted" data-reveal style={`--d: ${i + 2}`}>
              {p}
            </p>
          ))
        }
        <Stats lang={lang} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow eyebrow--center" data-reveal>{a.values.eyebrow}</p>
        <h2 data-reveal style="--d: 1">{a.values.title}</h2>
      </header>
      <ul class="values" role="list">
        {
          a.values.items.map((v, i) => (
            <li class="values__item card glow" data-reveal style={`--d: ${i % 3}`}>
              <span class="values__accent" aria-hidden="true"></span>
              <span class="values__icon">
                <Icon name={valueIcons[i] ?? 'check'} size={24} />
              </span>
              <h3>{v.title}</h3>
              <p class="muted">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow eyebrow--center" data-reveal>{a.team.eyebrow}</p>
        <h2 data-reveal style="--d: 1">{a.team.title}</h2>
        <p class="lead" data-reveal style="--d: 2">{a.team.lead}</p>
      </header>
      <ul class="team" role="list">
        {
          dentists.map((m, i) => {
            const pr = a.team.profiles[m.id];
            return (
              <li class="pro" data-reveal style={`--d: ${i}`}>
                <span class="pro__accent" aria-hidden="true"></span>

                <div class="pro__head">
                  <div class="pro__arch" aria-hidden="true">
                    <span>{initials(m.name)}</span>
                  </div>
                  <div class="pro__id">
                    <p class="pro__role">{a.team.roles[m.role]}</p>
                    <h3>{m.name}</h3>
                    {pr && (
                      <p class="pro__edu">
                        <Icon name="document" size={15} />
                        {pr.education}
                      </p>
                    )}
                  </div>
                </div>

                {pr ? (
                  <div class="pro__body">
                    <blockquote class="pro__quote">{pr.intro}</blockquote>

                    <div class="pro__tags">
                      <p>{a.team.labels[pr.tagsKind]}</p>
                      <ul role="list">
                        {pr.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    </div>

                    <div class="pro__about">
                      {pr.about.map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>

                    <div class="pro__cols">
                      <section>
                        <h4 class="pro__label">{a.team.labels.journey}</h4>
                        <ol class="timeline" role="list">
                          {pr.journey.map((step) => (
                            <li>
                              <strong>{step.title}</strong>
                              <span>{step.text}</span>
                            </li>
                          ))}
                        </ol>
                      </section>
                      <section>
                        <h4 class="pro__label">{a.team.labels.credentials}</h4>
                        <ul class="creds" role="list">
                          {pr.credentials.map((c) => (
                            <li>
                              <span class="creds__icon" aria-hidden="true">
                                <Icon name="check" size={12} />
                              </span>
                              {c}
                            </li>
                          ))}
                        </ul>
                      </section>
                    </div>
                  </div>
                ) : (
                  <div class="pro__body pro__body--soon">
                    <p class="pro__soon">
                      <Icon name="document" size={18} />
                      {a.team.soon}
                    </p>
                    <div class="pro__skeleton" aria-hidden="true">
                      <i></i><i></i><i></i><i></i>
                    </div>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>

      <ul class="crew" role="list">
        {
          crew.map((m, i) => (
            <li class="crew__card" data-reveal style={`--d: ${i}`}>
              <span class="crew__accent" aria-hidden="true"></span>
              <span class="crew__avatar" aria-hidden="true">
                <Icon name="user" size={34} />
              </span>
              <h3>{m.name}</h3>
              <p class="crew__role">{a.team.roles[m.role]}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: center;
  }

  .story__photo {
    overflow: hidden;
    aspect-ratio: 5 / 6;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .story__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .story__copy :global(.stats) {
    width: 100%;
    margin-top: var(--space-5);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
  }

  .values__item {
    position: relative;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    overflow: hidden;
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .values__item:hover {
    transform: translateY(-4px);
    border-color: var(--brand-200);
    box-shadow: var(--shadow-md);
  }

  .values__accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-600), var(--champagne) 85%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .values__item:hover .values__accent {
    transform: scaleX(1);
  }

  .values__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.1rem;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--brand-50), #fff);
    border: 1px solid var(--brand-100);
    color: var(--brand-600);
    transition:
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .values__item:hover .values__icon {
    background: var(--brand-600);
    color: #fff;
    box-shadow: var(--glow-brand);
    transform: rotate(-8deg) scale(1.06);
  }

  .values__item h3 {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    margin: 0;
  }

  /* ---------- Hekim profili: üstte kimlik bandı, altında tüm içerik ---------- */
  .pro {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(184, 151, 107, 0.3);
    border-radius: var(--radius-xl);
    background: var(--pearl);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--dur-slow) var(--ease-out),
      border-color var(--dur-slow) var(--ease-out);
  }

  .pro:hover {
    border-color: rgba(184, 151, 107, 0.6);
    box-shadow: var(--shadow-md);
  }

  .pro__accent {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 1;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-600), var(--champagne) 85%);
  }

  .pro__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.1rem, 0.8rem + 1vw, 1.6rem);
    padding: clamp(1.4rem, 1rem + 1.2vw, 2rem) clamp(1.4rem, 1rem + 1.5vw, 2.25rem);
    background:
      radial-gradient(60% 90% at 12% 0%, rgba(76, 195, 224, 0.2), transparent 70%),
      linear-gradient(170deg, var(--brand-50), var(--sand-100));
  }

  /* Portre: kemer biçimli pencere + şampanya halka. Fotoğraf gelince <img> arch içine girer. */
  .pro__arch {
    flex: none;
    display: grid;
    place-items: center;
    width: 96px;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 14px 14px;
    background: linear-gradient(165deg, #fff, var(--brand-50) 60%, var(--sand-100));
    box-shadow:
      0 0 0 1px rgba(184, 151, 107, 0.55),
      0 0 0 5px rgba(255, 255, 255, 0.6),
      0 0 0 6px rgba(184, 151, 107, 0.3);
  }

  .pro__arch span {
    font-family: var(--font-display);
    font-size: 2rem;
    font-style: italic;
    line-height: 1;
    color: var(--brand-600);
    opacity: 0.85;
  }

  .pro__id {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .pro__role {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-700);
  }

  .pro__role::before {
    content: '';
    width: 22px;
    height: 1px;
    background: var(--champagne);
  }

  .pro__id h3 {
    font-size: clamp(1.4rem, 1.15rem + 0.7vw, 1.75rem);
    line-height: 1.1;
  }

  .pro__edu {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .pro__edu :global(svg) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--brand-600);
  }

  .pro__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.4rem, 1rem + 1.2vw, 2rem) clamp(1.4rem, 1rem + 1.5vw, 2.25rem) clamp(1.5rem, 1rem + 1.2vw, 2rem);
  }

  .pro__quote {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--champagne);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--ink);
  }

  .pro__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.4rem;
  }

  .pro__tags p,
  .pro__label {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .pro__tags p {
    margin-right: 0.35rem;
  }

  .pro__tags ul {
    display: contents;
  }

  .pro__tags li {
    padding: 0.26rem 0.7rem;
    border: 1px solid rgba(184, 151, 107, 0.5);
    border-radius: var(--radius-pill);
    background: var(--ivory);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .pro__body--soon {
    gap: 1.25rem;
  }

  .pro__soon {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border: 1px dashed rgba(184, 151, 107, 0.6);
    border-radius: var(--radius-md);
    background: var(--ivory);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .pro__soon :global(svg) {
    color: var(--champagne);
  }

  /* Özgeçmiş gelene kadar sayfa dengesini koruyan soluk satırlar */
  .pro__skeleton {
    display: grid;
    gap: 0.7rem;
  }

  .pro__skeleton i {
    display: block;
    height: 9px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--sand-200), var(--sand-100));
    opacity: 0.8;
  }

  .pro__skeleton i:nth-child(2) {
    width: 88%;
  }

  .pro__skeleton i:nth-child(3) {
    width: 72%;
  }

  .pro__skeleton i:nth-child(4) {
    width: 55%;
  }

  .pro__about {
    display: grid;
    gap: 0.7rem;
  }

  .pro__about p {
    font-size: var(--text-xs);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .pro__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem clamp(1.25rem, 1rem + 1vw, 2rem);
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .pro__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
  }

  .pro__label::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--champagne);
  }

  .timeline {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    bottom: 0.45rem;
    left: 4px;
    width: 1px;
    background: linear-gradient(180deg, var(--champagne), rgba(184, 151, 107, 0.15));
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding-left: 1.3rem;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    top: 0.25rem;
    left: 0;
    width: 9px;
    height: 9px;
    border: 2px solid var(--champagne);
    border-radius: 50%;
    background: var(--pearl);
  }

  .timeline li:last-child::before {
    border-color: var(--brand-600);
    background: var(--brand-600);
  }

  .timeline strong {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-700);
  }

  .timeline span {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .creds {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
  }

  .creds li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ivory);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .creds__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--brand-600);
    color: #fff;
  }

  /* Klinik ekibi: ortalı, halkalı portre ve şampanya detaylı kartlar */
  .crew {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    margin: clamp(2rem, 1.5rem + 2vw, 3.25rem) 0 0;
  }

  .crew__card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    overflow: hidden;
    padding: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem) 1.5rem clamp(1.5rem, 1.2rem + 1vw, 2rem);
    border: 1px solid rgba(184, 151, 107, 0.3);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(76, 195, 224, 0.14), transparent 70%),
      var(--pearl);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out),
      border-color var(--dur-slow) var(--ease-out);
  }

  .crew__card:hover {
    transform: translateY(-5px);
    border-color: rgba(184, 151, 107, 0.6);
    box-shadow: var(--shadow-md);
  }

  .crew__accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-600), var(--champagne) 85%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .crew__card:hover .crew__accent {
    transform: scaleX(1);
  }

  .crew__avatar {
    display: grid;
    place-items: center;
    width: 92px;
    aspect-ratio: 1;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: linear-gradient(150deg, #fff, var(--brand-50) 55%, var(--sand-100));
    box-shadow:
      0 0 0 1px rgba(184, 151, 107, 0.55),
      0 0 0 6px rgba(255, 255, 255, 0.7),
      0 0 0 7px rgba(184, 151, 107, 0.3),
      var(--shadow-sm);
    color: var(--brand-600);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .crew__card:hover .crew__avatar {
    transform: scale(1.05);
  }

  .crew__card h3 {
    font-size: clamp(1.35rem, 1.2rem + 0.4vw, 1.55rem);
    line-height: 1.15;
  }

  .crew__role {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-700);
  }

  .crew__role::before,
  .crew__role::after {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--champagne);
  }

  @media (max-width: 860px) {
    .story,
    .values {
      grid-template-columns: 1fr;
    }

    .story__photo {
      aspect-ratio: 4 / 3;
    }
  }

  /* İki kolon sığmayınca hekimler alt alta, geniş kartta yolculuk ve belgeler yan yana */
  @media (max-width: 1100px) {
    .team {
      grid-template-columns: minmax(0, 1fr);
    }

    .pro__head {
      flex-direction: row;
      align-items: center;
    }

    .pro__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .crew {
      grid-template-columns: minmax(0, 1fr);
      max-width: 420px;
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    .pro__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .pro__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
