---
import { Image } from 'astro:assets';
import room from '@/assets/images/clinic-room.jpg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Stats from '@/components/ui/Stats.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { site } from '@/config/site';
import { getDictionary, localeStaticPaths, localizePath, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const a = t.about;
const valueIcons: IconName[] = ['document', 'leaf', 'infinity', 'sparkles', 'shield', 'clock'];

/** "Dt. Dilara Nur Kılınç" → "DK" */
const initials = (name: string) =>
  name
    .replace(/^Dt\.\s*/, '')
    .split(/\s+/)
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .map((w) => w[0])
    .join('');
---

<BaseLayout lang={lang} title={a.meta.title} description={a.meta.description} path="about">
  <PageHero
    eyebrow={a.hero.eyebrow}
    title={a.hero.title}
    lead={a.hero.lead}
    crumbs={[{ label: t.common.breadcrumbHome, href: localizePath(lang) }, { label: t.nav.about }]}
  />

  <section class="section section--pearl">
    <div class="container story">
      <figure class="story__photo" data-reveal="curtain">
        <Image src={room} alt={t.gallery.captions.room} widths={[480, 720, 960, 1200]} sizes="(max-width: 860px) 92vw, 48vw" />
      </figure>
      <div class="story__copy">
        <p class="eyebrow" data-reveal>{a.story.eyebrow}</p>
        <h2 data-reveal style="--d: 1">{a.story.title}</h2>
        {
          a.story.body.map((p, i) => (
            <p class="muted" data-reveal style={`--d: ${i + 2}`}>
              {p}
            </p>
          ))
        }
        <Stats lang={lang} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow eyebrow--center" data-reveal>{a.values.eyebrow}</p>
        <h2 data-reveal style="--d: 1">{a.values.title}</h2>
      </header>
      <ul class="values" role="list">
        {
          a.values.items.map((v, i) => (
            <li class="values__item card glow" data-reveal style={`--d: ${i % 3}`}>
              <span class="values__accent" aria-hidden="true"></span>
              <span class="values__icon">
                <Icon name={valueIcons[i] ?? 'check'} size={24} />
              </span>
              <h3>{v.title}</h3>
              <p class="muted">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow eyebrow--center" data-reveal>{a.team.eyebrow}</p>
        <h2 data-reveal style="--d: 1">{a.team.title}</h2>
        <p class="lead" data-reveal style="--d: 2">{a.team.lead}</p>
      </header>
      <ul class="team" role="list">
        {
          site.doctors.map((doc, i) => (
            <li class="team__card" data-reveal style={`--d: ${i}`}>
              <div class="team__portrait" aria-hidden="true">
                <span>{initials(doc.name)}</span>
                <small>{a.team.photoSoon}</small>
              </div>
              <div class="team__info">
                <h3>{doc.name}</h3>
                <p>{a.team.dentist}</p>
                {a.team.bios[doc.id] && <p class="team__bio">{a.team.bios[doc.id]}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: center;
  }

  .story__photo {
    overflow: hidden;
    aspect-ratio: 5 / 6;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .story__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .story__copy :global(.stats) {
    width: 100%;
    margin-top: var(--space-5);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
  }

  .values__item {
    position: relative;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    overflow: hidden;
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .values__item:hover {
    transform: translateY(-4px);
    border-color: var(--brand-200);
    box-shadow: var(--shadow-md);
  }

  .values__accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-600), var(--champagne) 85%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .values__item:hover .values__accent {
    transform: scaleX(1);
  }

  .values__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.1rem;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--brand-50), #fff);
    border: 1px solid var(--brand-100);
    color: var(--brand-600);
    transition:
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .values__item:hover .values__icon {
    background: var(--brand-600);
    color: #fff;
    box-shadow: var(--glow-brand);
    transform: rotate(-8deg) scale(1.06);
  }

  .values__item h3 {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 340px));
    justify-content: center;
    gap: 2rem;
    margin: 0;
  }

  .team__card {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--pearl);
    box-shadow: var(--shadow-sm);
  }

  .team__portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    background:
      radial-gradient(70% 60% at 50% 35%, rgba(76, 195, 224, 0.25), transparent 70%),
      linear-gradient(160deg, var(--brand-50), var(--sand-100));
  }

  .team__portrait span {
    font-family: var(--font-display);
    font-size: 5rem;
    font-style: italic;
    color: var(--brand-600);
    opacity: 0.8;
  }

  .team__portrait small {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    translate: -50% 0;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.7);
    font-size: var(--text-xs);
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .team__info {
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .team__info p {
    margin-top: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-700);
  }

  .team__info .team__bio {
    margin-top: 1rem;
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .story,
    .values {
      grid-template-columns: 1fr;
    }

    .story__photo {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 640px) {
    .team {
      grid-template-columns: minmax(0, 340px);
    }
  }
</style>
